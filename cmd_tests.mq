    ["ping", "2 packets transmitted, 2 packets received, 0.0% packet loss\nround-trip min/avg/max/stddev = 0.6/0.9/1.1/0.2 ms"],
    ["lsof", "COMMAND PID USER FD TYPE DEVICE SIZE/OFF NODE NAME\nzsh 42 alice cwd DIR 1,19 288 1 /tmp"],
    ["free", "               total        used        free\nMem:        16336000     4200000     5000000"],
    ["top", "load avg\n  PID USER %CPU COMMAND\n  1 root 0.5 init"],
