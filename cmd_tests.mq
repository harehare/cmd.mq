include "test"
| include "cmd"
|

def test_columns_parse_basic():
  let result = columns_parse("PID CMD\n1 init\n2 sh")
  | assert_eq(result, [{"PID": "1", "CMD": "init"}, {"PID": "2", "CMD": "sh"}])
end

def test_columns_parse_last_column_keeps_spaces():
  let result = columns_parse("PID CMD\n1 python  -m   http.server")
  | assert_eq(result[0]["CMD"], "python  -m   http.server")
end

def test_columns_parse_custom_headers():
  let result = columns_parse("ignored header\n1 2", ["a", "b"])
  | assert_eq(result, [{"a": "1", "b": "2"}])
end

def test_columns_parse_missing_value_is_empty():
  let result = columns_parse("A B\n1")
  | assert_eq(result, [{"A": "1", "B": ""}])
end

def test_columns_parse_empty_input():
  assert_eq(columns_parse(""), [])
end

def test_table_parse_values_with_spaces():
  let result = table_parse("CONTAINER ID   IMAGE     STATUS\nabc123         nginx     Up 2 hours\nde4567         redis     Exited (0) 3 days ago")
  | assert_eq(len(result), 2)
  | assert_eq(result[0], {"CONTAINER ID": "abc123", "IMAGE": "nginx", "STATUS": "Up 2 hours"})
  | assert_eq(result[1]["STATUS"], "Exited (0) 3 days ago")
end

def test_table_parse_empty_input():
  assert_eq(table_parse(""), [])
end

def test_kv_parse_splits_on_first_separator():
  let result = kv_parse("Name: Alice\nTime: 12:30")
  | assert_eq(result, {"Name": "Alice", "Time": "12:30"})
end

def test_kv_parse_env_style():
  let result = kv_parse("A=1\nB=x=y", "=")
  | assert_eq(result, {"A": "1", "B": "x=y"})
end

def test_kv_parse_skips_lines_without_separator():
  let result = kv_parse("no separator\nkey: value")
  | assert_eq(result, {"key": "value"})
end

def test_kv_blocks_parse_splits_on_blank_lines():
  let result = kv_blocks_parse("a: 1\nb: 2\n\na: 3")
  | assert_eq(result, [{"a": "1", "b": "2"}, {"a": "3"}])
end

def test_ps_parse_converts_numeric_fields():
  let result = ps_parse("USER PID %CPU %MEM COMMAND\nroot 1 0.5 1.2 /sbin/init  -x")
  | assert_eq(result, [{"user": "root", "pid": 1, "cpu_percent": 0.5, "mem_percent": 1.2, "command": "/sbin/init  -x"}])
end

def test_ps_parse_empty_input():
  assert_eq(ps_parse(""), [])
end

def test_df_parse_linux_kilobytes():
  let result = df_parse("Filesystem 1K-blocks Used Available Use% Mounted on\n/dev/sda1 100 40 60 40% /")
  | assert_eq(result, [{"filesystem": "/dev/sda1", "1k-blocks": 100, "used": 40, "available": 60, "use_percent": "40%", "mounted_on": "/"}])
end

def test_df_parse_mount_point_with_space():
  let result = df_parse("Filesystem 1K-blocks Used Available Use% Mounted on\n/dev/sdb1 100 40 60 40% /Volumes/My Drive")
  | assert_eq(result[0]["mounted_on"], "/Volumes/My Drive")
end

def test_df_parse_human_readable_sizes_stay_strings():
  let result = df_parse("Filesystem Size Used Avail Use% Mounted on\n/dev/sda1 460Gi 200Gi 260Gi 44% /")
  | assert_eq(result[0]["size"], "460Gi")
end

def test_du_parse_numeric_size():
  let result = du_parse("8\t./src\n16\t.")
  | assert_eq(result, [{"size": 8, "path": "./src"}, {"size": 16, "path": "."}])
end

def test_du_parse_human_readable_size_stays_string():
  let result = du_parse("4.0K\t./a b")
  | assert_eq(result, [{"size": "4.0K", "path": "./a b"}])
end

def test_ls_parse_file_and_directory():
  let result = ls_parse("total 8\n-rw-r--r--@  1 alice  staff   12 Jan  1 12:00 my file.txt\ndrwxr-xr-x   5 alice  staff  160 Dec 25  2023 src")
  | assert_eq(len(result), 2)
  | assert_eq(result[0], {"type": "file", "permissions": "-rw-r--r--@", "links": 1, "owner": "alice", "group": "staff", "size": 12, "modified": "Jan 1 12:00", "name": "my file.txt"})
  | assert_eq(result[1]["type"], "directory")
  | assert_eq(result[1]["modified"], "Dec 25 2023")
end

def test_ls_parse_symlink_target():
  let result = ls_parse("lrwxr-xr-x   1 alice  staff    5 Jan  1 12:00 ln -> target.txt")
  | assert_eq(result[0]["type"], "symlink")
  | assert_eq(result[0]["name"], "ln")
  | assert_eq(result[0]["link_target"], "target.txt")
end

def test_ls_parse_skips_non_entries():
  assert_eq(ls_parse("total 0\nnot an entry"), [])
end

def test_git_log_parse_commits():
  let result = git_log_parse("commit abc123 (HEAD -> main)\nAuthor: A <a@x.dev>\nDate:   Mon Jan 1 12:00:00 2024 +0000\n\n    fix bug\n    \n    more detail\n\ncommit def456\nMerge: 1 2\nAuthor: B <b@x.dev>\nDate:   Tue Jan 2 12:00:00 2024 +0000\n\n    merge\n")
  | assert_eq(len(result), 2)
  | assert_eq(result[0], {"commit": "abc123", "author": "A <a@x.dev>", "date": "Mon Jan 1 12:00:00 2024 +0000", "message": "fix bug\n\nmore detail", "refs": "HEAD -> main"})
  | assert_eq(result[1]["merge"], "1 2")
  | assert_eq(result[1]["message"], "merge")
end

def test_git_log_parse_empty_input():
  assert_eq(git_log_parse(""), [])
end

def test_parse_output_dispatches_by_key():
  assert_eq(parse_output("du", "8\t./src"), [{"size": 8, "path": "./src"}])
  | assert_eq(parse_output("env", "A=1"), {"A": "1"})
end

def test_parse_output_unknown_key_raises():
  assert_eq(try: parse_output("nope", "") catch: "error", "error")
end

def test_git_status_parse_codes_and_rename():
  let result = git_status_parse("## main...origin/main\nR  old.txt -> new.txt\n M a.rs\n?? b.txt")
  | assert_eq(len(result), 3)
  | assert_eq(result[0], {"index": "R", "worktree": " ", "path": "new.txt", "orig_path": "old.txt"})
  | assert_eq(result[1], {"index": " ", "worktree": "M", "path": "a.rs"})
  | assert_eq(result[2], {"index": "?", "worktree": "?", "path": "b.txt"})
end

def test_git_status_parse_clean_tree():
  assert_eq(git_status_parse(""), [])
end

def test_git_branch_parse_current_marker():
  let result = git_branch_parse("* main\n  dev")
  | assert_eq(result, [{"name": "main", "current": true}, {"name": "dev", "current": false}])
end

def test_git_branch_parse_verbose():
  let result = git_branch_parse("* main 8d3580f5 fix bug\n  dev  1a2b3c4 wip")
  | assert_eq(result[0], {"name": "main", "commit": "8d3580f5", "message": "fix bug", "current": true})
  | assert_eq(result[1]["name"], "dev")
end

def test_git_branch_parse_detached_head():
  let result = git_branch_parse("* (HEAD detached at abc1234)\n  main")
  | assert_eq(result[0]["name"], "(HEAD detached at abc1234)")
end

def test_id_parse_full():
  let result = id_parse("uid=501(alice) gid=20(staff) groups=20(staff),12(everyone)")
  | assert_eq(result["uid"], 501)
  | assert_eq(result["user"], "alice")
  | assert_eq(result["group"], "staff")
  | assert_eq(result["groups"], [{"id": 20, "name": "staff"}, {"id": 12, "name": "everyone"}])
end

def test_id_parse_without_groups():
  let result = id_parse("uid=0(root) gid=0(root)")
  | assert_eq(result, {"uid": 0, "user": "root", "gid": 0, "group": "root"})
end

def test_id_parse_invalid_input():
  assert_eq(id_parse("not id output"), {})
end

def test_wc_parse_with_files_and_total():
  let result = wc_parse("       1       3       6 a.txt\n       2       4       8 total")
  | assert_eq(result, [{"lines": 1, "words": 3, "bytes": 6, "file": "a.txt"}, {"lines": 2, "words": 4, "bytes": 8, "file": "total"}])
end

def test_wc_parse_stdin_has_no_file():
  assert_eq(wc_parse("       1       3       6"), [{"lines": 1, "words": 3, "bytes": 6}])
end

def test_ping_parse_macos():
  let result = ping_parse("2 packets transmitted, 2 packets received, 0.0% packet loss\nround-trip min/avg/max/stddev = 0.6/0.9/1.1/0.2 ms")
  | assert_eq(result, {"transmitted": 2, "received": 2, "loss_percent": 0, "rtt_min": 0.6, "rtt_avg": 0.9, "rtt_max": 1.1, "rtt_stddev": 0.2})
end

def test_ping_parse_linux():
  let result = ping_parse("2 packets transmitted, 2 received, 0% packet loss, time 1001ms\nrtt min/avg/max/mdev = 0.031/0.040/0.049/0.009 ms")
  | assert_eq(result["received"], 2)
  | assert_eq(result["rtt_avg"], 0.04)
end

def test_ping_parse_total_loss_has_no_rtt():
  let result = ping_parse("3 packets transmitted, 0 received, 100% packet loss, time 2003ms")
  | assert_eq(result, {"transmitted": 3, "received": 0, "loss_percent": 100})
end

def test_ping_parse_without_summary():
  assert_eq(ping_parse("ping: cannot resolve host"), {})
end

def test_lsof_parse_name_keeps_spaces():
  let result = lsof_parse("COMMAND PID USER FD SIZE/OFF NAME\nzsh 42 alice cwd 288 /tmp/my dir")
  | assert_eq(result, [{"command": "zsh", "pid": 42, "user": "alice", "fd": "cwd", "size_off": "288", "name": "/tmp/my dir"}])
end

def test_free_parse_drops_missing_swap_columns():
  let result = free_parse("               total        used        free      shared  buff/cache   available\nMem:        16336000     4200000     5000000      300000     7136000    11500000\nSwap:        2097148           0     2097148")
  | assert_eq(result[0], {"type": "Mem", "total": 16336000, "used": 4200000, "free": 5000000, "shared": 300000, "buff_cache": 7136000, "available": 11500000})
  | assert_eq(result[1], {"type": "Swap", "total": 2097148, "used": 0, "free": 2097148})
end

def test_free_parse_human_readable_stays_string():
  let result = free_parse("       total  used\nMem:    15Gi   4Gi")
  | assert_eq(result[0]["total"], "15Gi")
end

def test_pip_list_parse_uses_dash_offsets():
  let result = pip_list_parse("Package    Version Editable project location\n---------- ------- -------------------------\nmypkg      0.1.0   /home/a/mypkg\nrequests   2.31.0")
  | assert_eq(result[0], {"package": "mypkg", "version": "0.1.0", "editable_project_location": "/home/a/mypkg"})
  | assert_eq(result[1], {"package": "requests", "version": "2.31.0", "editable_project_location": ""})
end

def test_pip_list_parse_empty_input():
  assert_eq(pip_list_parse(""), [])
end

def test_parse_output_dispatches_new_keys():
  assert_eq(parse_output("wc", "1 2 3 a"), [{"lines": 1, "words": 2, "bytes": 3, "file": "a"}])
  | assert_eq(parse_output("sw_vers", "ProductName:\tmacOS"), {"ProductName": "macOS"})
  | assert_eq(parse_output("printenv", "A=1"), {"A": "1"})
  | assert_eq(parse_output("docker images", "REPOSITORY   TAG      IMAGE ID\nnginx        latest   abc123"), [{"REPOSITORY": "nginx", "TAG": "latest", "IMAGE ID": "abc123"}])
end

def test_lines_parse_drops_blank_lines_and_trims():
  assert_eq(lines_parse("a\n\n b \n"), ["a", "b"])
end

def test_uniq_c_parse():
  assert_eq(uniq_c_parse("      2 a\n      1 b c"), [{"count": 2, "value": "a"}, {"count": 1, "value": "b c"}])
end

def test_grep_parse_with_and_without_line_numbers():
  assert_eq(grep_parse("a.rs:12:let x = 1;"), [{"file": "a.rs", "line": 12, "text": "let x = 1;"}])
  | assert_eq(grep_parse("a.rs:let x = 1;"), [{"file": "a.rs", "text": "let x = 1;"}])
end

def test_file_parse():
  assert_eq(file_parse("a.txt: ASCII text\nb.png: PNG image data, 1 x 1"), [{"path": "a.txt", "description": "ASCII text"}, {"path": "b.png", "description": "PNG image data, 1 x 1"}])
end

def test_checksum_parse_gnu_and_bsd():
  assert_eq(checksum_parse("d41d8cd98f00b204e9800998ecf8427e  empty.txt"), [{"hash": "d41d8cd98f00b204e9800998ecf8427e", "file": "empty.txt"}])
  | assert_eq(checksum_parse("MD5 (a b.txt) = d41d8cd98f00b204e9800998ecf8427e"), [{"algorithm": "MD5", "hash": "d41d8cd98f00b204e9800998ecf8427e", "file": "a b.txt"}])
end

def test_pgrep_parse_with_and_without_names():
  assert_eq(pgrep_parse("123 zsh\n456"), [{"pid": 123, "name": "zsh"}, {"pid": 456}])
end

def test_arp_parse():
  assert_eq(arp_parse("? (192.168.1.1) at aa:bb:cc:dd:ee:ff on en0 ifscope [ethernet]"), [{"host": "?", "ip": "192.168.1.1", "mac": "aa:bb:cc:dd:ee:ff", "interface": "en0"}])
end

def test_uptime_parse_macos_and_linux():
  assert_eq(uptime_parse("14:38  up 1:54, 1 user, load averages: 3.09 3.24 5.65"), {"time": "14:38", "uptime": "1:54", "users": 1, "load_1": 3.09, "load_5": 3.24, "load_15": 5.65})
  | assert_eq(uptime_parse(" 12:34:56 up 5 days,  3:21,  2 users,  load average: 1.23, 1.45, 1.67")["uptime"], "5 days,  3:21")
  | assert_eq(uptime_parse("nope"), {})
end

def test_who_parse_with_host():
  assert_eq(who_parse("alice ttys000 Sep 20 12:01 (10.0.0.5)\nbob console Sep 20 12:45"), [{"user": "alice", "tty": "ttys000", "login": "Sep 20 12:01", "host": "10.0.0.5"}, {"user": "bob", "tty": "console", "login": "Sep 20 12:45"}])
end

def test_w_parse_skips_uptime_line():
  assert_eq(w_parse("12:34 up 1 day\nUSER TTY FROM LOGIN@ IDLE WHAT\nalice ttys000 - 09:00 1 -zsh"), [{"user": "alice", "tty": "ttys000", "from": "-", "login": "09:00", "idle": "1", "what": "-zsh"}])
end

def test_mount_parse_macos_and_linux():
  assert_eq(mount_parse("/dev/disk3s1s1 on / (apfs, sealed, local, read-only)"), [{"device": "/dev/disk3s1s1", "mount_point": "/", "type": "apfs", "options": ["sealed", "local", "read-only"]}])
  | assert_eq(mount_parse("sysfs on /sys type sysfs (rw,nosuid)"), [{"device": "sysfs", "mount_point": "/sys", "type": "sysfs", "options": ["rw", "nosuid"]}])
end

def test_uname_parse_macos_and_linux():
  assert_eq(uname_parse("Darwin host.local 27.0.0 Darwin Kernel Version 27.0.0: Tue Aug 11; root:xnu-1 arm64"), {"kernel_name": "Darwin", "node_name": "host.local", "kernel_release": "27.0.0", "kernel_version": "Darwin Kernel Version 27.0.0: Tue Aug 11; root:xnu-1", "machine": "arm64"})
  | assert_eq(uname_parse("Linux host 5.15.0 #1 SMP Mon x86_64 x86_64 x86_64 GNU/Linux"), {"kernel_name": "Linux", "node_name": "host", "kernel_release": "5.15.0", "kernel_version": "#1 SMP Mon", "machine": "x86_64"})
end

def test_sysctl_parse_both_separators():
  assert_eq(sysctl_parse("hw.ncpu: 12\nkernel.ostype = Linux"), {"hw.ncpu": "12", "kernel.ostype": "Linux"})
end

def test_vm_stat_parse():
  assert_eq(vm_stat_parse("Mach Virtual Memory Statistics: (page size of 16384 bytes)\nPages free:    100.\n\"Pages purgeable\":   5."), {"pages_free": 100, "pages_purgeable": 5, "page_size": 16384})
end

def test_vmstat_parse_uses_second_header_line():
  assert_eq(vmstat_parse("procs ---memory---\n r  b  free\n 1  0  100"), [{"r": 1, "b": 0, "free": 100}])
end

def test_top_parse_skips_summary():
  assert_eq(top_parse("load avg\n  PID USER %CPU COMMAND\n  1 root 0.5 init"), [{"pid": 1, "user": "root", "cpu_percent": 0.5, "command": "init"}])
end

def test_launchctl_list_parse_dash_pid_is_none():
  assert_eq(launchctl_list_parse("PID\tStatus\tLabel\n-\t0\tcom.example.job\n123\t0\tcom.example.run"), [{"pid": None, "status": 0, "label": "com.example.job"}, {"pid": 123, "status": 0, "label": "com.example.run"}])
end

def test_ifconfig_parse_macos():
  let result = ifconfig_parse("lo0: flags=8049<UP,LOOPBACK> mtu 16384\n\tinet 127.0.0.1 netmask 0xff000000\n\tinet6 ::1 prefixlen 128\nen0: flags=8863<UP,BROADCAST> mtu 1500\n\tether aa:bb:cc:dd:ee:ff\n\tstatus: active")
  | assert_eq(len(result), 2)
  | assert_eq(result[0], {"name": "lo0", "flags": ["UP", "LOOPBACK"], "mtu": 16384, "ipv4": [{"address": "127.0.0.1", "netmask": "0xff000000"}], "ipv6": [{"address": "::1", "prefixlen": 128}]})
  | assert_eq(result[1]["ether"], "aa:bb:cc:dd:ee:ff")
  | assert_eq(result[1]["status"], "active")
end

def test_netstat_parse_linux_and_macos():
  let result = netstat_parse("Proto Recv-Q Send-Q Local Address Foreign Address State PID/Program name\ntcp 0 0 0.0.0.0:22 0.0.0.0:* LISTEN 812/sshd\ntcp4 0 0 127.0.0.1.8080 *.* LISTEN\nudp4 0 0 *.5353 *.*")
  | assert_eq(len(result), 3)
  | assert_eq(result[0], {"proto": "tcp", "recv_q": 0, "send_q": 0, "local_address": "0.0.0.0:22", "foreign_address": "0.0.0.0:*", "state": "LISTEN", "program": "812/sshd"})
  | assert_eq(result[2], {"proto": "udp4", "recv_q": 0, "send_q": 0, "local_address": "*.5353", "foreign_address": "*.*"})
end

def test_mdls_parse_unquotes_and_null():
  assert_eq(mdls_parse("kMDItemKind = \"Text\"\nkMDItemFSSize = 6\nkMDItemNote = (null)"), {"kMDItemKind": "Text", "kMDItemFSSize": "6", "kMDItemNote": None})
end

def test_otool_l_parse():
  assert_eq(otool_l_parse("/bin/ls:\n\t/usr/lib/libSystem.B.dylib (compatibility version 1.0.0, current version 1351.0.0)"), [{"path": "/usr/lib/libSystem.B.dylib", "compatibility_version": "1.0.0", "current_version": "1351.0.0"}])
end

def test_unzip_list_parse_skips_header_and_totals():
  assert_eq(unzip_list_parse("  Length      Date    Time    Name\n---------  ---------- -----   ----\n        6  09-20-2026 14:38   a.txt\n---------                     -------\n        6                     1 file"), [{"size": 6, "date": "09-20-2026", "time": "14:38", "name": "a.txt"}])
end

def test_tar_parse_gnu_and_bsdtar():
  assert_eq(tar_parse("-rw-r--r-- alice/staff 12 2024-01-01 12:00 a.txt"), [{"permissions": "-rw-r--r--", "owner": "alice/staff", "size": 12, "modified": "2024-01-01 12:00", "name": "a.txt"}])
  | assert_eq(tar_parse("-rw-r--r--  0 alice staff      6 Sep 20 14:38 a.txt")[0]["name"], "a.txt")
end

def test_git_log_oneline_parse():
  assert_eq(git_log_oneline_parse("abc1234 (HEAD -> main) fix bug\ndef5678 add feature"), [{"commit": "abc1234", "message": "fix bug", "refs": "HEAD -> main"}, {"commit": "def5678", "message": "add feature"}])
end

def test_git_shortlog_parse():
  assert_eq(git_shortlog_parse("    12\tAlice <a@x.dev>\n     3\tBob"), [{"commits": 12, "author": "Alice", "email": "a@x.dev"}, {"commits": 3, "author": "Bob"}])
end

def test_git_remote_parse():
  assert_eq(git_remote_parse("origin\thttps://example.com/r.git (fetch)\norigin\thttps://example.com/r.git (push)"), [{"name": "origin", "url": "https://example.com/r.git", "direction": "fetch"}, {"name": "origin", "url": "https://example.com/r.git", "direction": "push"}])
end

def test_git_stash_list_parse():
  assert_eq(git_stash_list_parse("stash@{0}: WIP on main: abc1234 fix bug\nstash@{1}: On dev: manual"), [{"index": 0, "ref": "stash@{0}", "branch": "main", "message": "abc1234 fix bug"}, {"index": 1, "ref": "stash@{1}", "branch": "dev", "message": "manual"}])
end

def test_git_reflog_parse():
  assert_eq(git_reflog_parse("abc1234 HEAD@{0}: commit: fix bug\ndef5678 HEAD@{1}: checkout: moving from a to b"), [{"commit": "abc1234", "ref": "HEAD@{0}", "action": "commit", "message": "fix bug"}, {"commit": "def5678", "ref": "HEAD@{1}", "action": "checkout", "message": "moving from a to b"}])
end

def test_git_diff_numstat_parse_binary_is_none():
  assert_eq(git_diff_numstat_parse("12\t3\tsrc/a.rs\n-\t-\timg.png"), [{"added": 12, "deleted": 3, "path": "src/a.rs"}, {"added": None, "deleted": None, "path": "img.png"}])
end

def test_git_diff_stat_parse():
  assert_eq(git_diff_stat_parse(" src/a.rs | 5 ++---\n img.png | Bin 0 -> 12 bytes\n 2 files changed, 2 insertions(+), 3 deletions(-)"), {"files": [{"path": "src/a.rs", "changes": 5}, {"path": "img.png", "binary": true}], "files_changed": 2, "insertions": 2, "deletions": 3})
end

def test_git_worktree_parse():
  assert_eq(git_worktree_parse("/repo  abc1234 [main]\n/repo/wt  def5678 (detached HEAD)"), [{"path": "/repo", "commit": "abc1234", "branch": "main"}, {"path": "/repo/wt", "commit": "def5678", "state": "detached HEAD"}])
end

def test_pip_freeze_parse():
  assert_eq(pip_freeze_parse("requests==2.31.0\nmypkg @ file:///src/mypkg"), [{"name": "requests", "version": "2.31.0"}, {"name": "mypkg", "url": "file:///src/mypkg"}])
end

def test_pip_show_parse_multiple_packages():
  assert_eq(pip_show_parse("Name: a\nVersion: 1\n---\nName: b\nVersion: 2"), [{"Name": "a", "Version": "1"}, {"Name": "b", "Version": "2"}])
end

def test_brew_list_parse():
  assert_eq(brew_list_parse("jq 1.7.1\ngit 2.45.0 2.44.0\nwget"), [{"name": "jq", "versions": ["1.7.1"]}, {"name": "git", "versions": ["2.45.0", "2.44.0"]}, {"name": "wget", "versions": []}])
end

def test_brew_outdated_parse():
  assert_eq(brew_outdated_parse("jq (1.6) < 1.7.1\nwget"), [{"name": "jq", "installed_versions": ["1.6"], "current_version": "1.7.1"}, {"name": "wget"}])
end

def test_gem_list_parse():
  assert_eq(gem_list_parse("rake (13.0.6, default: 12.0)"), [{"name": "rake", "versions": ["13.0.6", "default: 12.0"]}])
end

def test_cargo_install_list_parse():
  assert_eq(cargo_install_list_parse("mq-run v0.8.5:\n    mq\nmytool v0.1.0 (/src/mytool):\n    a\n    b"), [{"name": "mq-run", "version": "0.8.5", "binaries": ["mq"]}, {"name": "mytool", "version": "0.1.0", "binaries": ["a", "b"], "source": "/src/mytool"}])
end

def test_npm_ls_parse_depth_and_scoped_names():
  assert_eq(npm_ls_parse("app@1.0.0 /src/app\n├── left-pad@1.3.0\n├─┬ express@4.18.2\n│ └── body-parser@1.20.1\n└── @scope/pkg@2.0.0"), [{"name": "left-pad", "version": "1.3.0", "depth": 1}, {"name": "express", "version": "4.18.2", "depth": 1}, {"name": "body-parser", "version": "1.20.1", "depth": 2}, {"name": "@scope/pkg", "version": "2.0.0", "depth": 1}])
end

def test_dpkg_list_parse_skips_header():
  assert_eq(dpkg_list_parse("||/ Name Version Architecture Description\n+++-==-==-==-==\nii  adduser  3.118  all  add and remove users"), [{"status": "ii", "name": "adduser", "version": "3.118", "architecture": "all", "description": "add and remove users"}])
end

def test_apt_list_parse():
  assert_eq(apt_list_parse("Listing... Done\ncurl/jammy-updates,now 7.81.0-1 amd64 [installed]"), [{"name": "curl", "suite": "jammy-updates,now", "version": "7.81.0-1", "architecture": "amd64", "status": "installed"}])
end

def test_pacman_q_parse():
  assert_eq(pacman_q_parse("linux 6.6.1.arch1-1"), [{"name": "linux", "version": "6.6.1.arch1-1"}])
end

def test_conda_list_parse_skips_comments():
  assert_eq(conda_list_parse("# packages in environment\n#\n# Name Version Build Channel\nnumpy 1.26.4 py311h1 conda-forge\nzlib 1.2.13 h1"), [{"name": "numpy", "version": "1.26.4", "build": "py311h1", "channel": "conda-forge"}, {"name": "zlib", "version": "1.2.13", "build": "h1", "channel": ""}])
end

def test_dnf_list_parse():
  assert_eq(dnf_list_parse("Installed Packages\nbash.x86_64  5.2.15-3.fc39  @anaconda"), [{"name": "bash", "architecture": "x86_64", "version": "5.2.15-3.fc39", "repo": "@anaconda"}])
end

def test_helm_list_parse_tab_separated():
  assert_eq(helm_list_parse("NAME\tNAMESPACE\tREVISION\tAPP VERSION\nweb\tprod\t3\t1.16"), [{"name": "web", "namespace": "prod", "revision": 3, "app_version": "1.16"}])
end

def test_snap_list_parse():
  assert_eq(snap_list_parse("Name Version Rev Tracking Publisher Notes\ncore20 20240111 2182 latest/stable canonical** base"), [{"name": "core20", "version": "20240111", "rev": 2182, "tracking": "latest/stable", "publisher": "canonical**", "notes": "base"}])
end

def test_ip_addr_parse_brief():
  assert_eq(ip_addr_parse("lo UNKNOWN 127.0.0.1/8 ::1/128\neth0 UP 10.0.0.2/24"), [{"name": "lo", "state": "UNKNOWN", "addresses": ["127.0.0.1/8", "::1/128"]}, {"name": "eth0", "state": "UP", "addresses": ["10.0.0.2/24"]}])
end

def test_ip_addr_parse_full():
  let result = ip_addr_parse("1: lo: <LOOPBACK,UP> mtu 65536 qdisc noqueue state UNKNOWN group default\n    link/loopback 00:00:00:00:00:00 brd 00:00:00:00:00:00\n    inet 127.0.0.1/8 scope host lo\n    inet6 ::1/128 scope host\n2: eth0: <BROADCAST,UP> mtu 1500 qdisc fq_codel state UP group default\n    link/ether aa:bb:cc:dd:ee:ff brd ff:ff:ff:ff:ff:ff\n    inet 10.0.0.2/24 brd 10.0.0.255 scope global eth0")
  | assert_eq(result[0], {"index": 1, "name": "lo", "flags": ["LOOPBACK", "UP"], "mtu": 65536, "state": "UNKNOWN", "mac": "00:00:00:00:00:00", "ipv4": ["127.0.0.1/8"], "ipv6": ["::1/128"]})
  | assert_eq(result[1]["ipv4"], ["10.0.0.2/24"])
  | assert_eq(result[1]["ipv6"], [])
end

def test_ip_route_parse_pairs_flags_and_type():
  assert_eq(ip_route_parse("default via 192.168.1.1 dev eth0 proto dhcp metric 100\n192.168.1.0/24 dev eth0 scope link linkdown\nblackhole 10.9.0.0/16"), [{"destination": "default", "via": "192.168.1.1", "dev": "eth0", "proto": "dhcp", "metric": 100}, {"destination": "192.168.1.0/24", "dev": "eth0", "scope": "link", "flags": ["linkdown"]}, {"destination": "10.9.0.0/16", "type": "blackhole"}])
end

def test_ss_parse_with_and_without_netid():
  assert_eq(ss_parse("Netid State Recv-Q Send-Q Local Address:Port Peer Address:Port Process\ntcp LISTEN 0 4096 0.0.0.0:22 0.0.0.0:* users:((\"sshd\",pid=1,fd=3))")[0], {"netid": "tcp", "state": "LISTEN", "recv_q": 0, "send_q": 4096, "local_address": "0.0.0.0:22", "peer_address": "0.0.0.0:*", "process": "users:((\"sshd\",pid=1,fd=3))"})
  | assert_eq(ss_parse("State Recv-Q Send-Q Local Address:Port Peer Address:Port\nLISTEN 0 128 *:80 *:*"), [{"state": "LISTEN", "recv_q": 0, "send_q": 128, "local_address": "*:80", "peer_address": "*:*"}])
end

def test_lsblk_parse_strips_tree_glyphs():
  assert_eq(lsblk_parse("NAME MAJ:MIN RM SIZE RO TYPE MOUNTPOINTS\nsda 8:0 0 100G 0 disk\n├─sda1 8:1 0 512M 0 part /boot/efi"), [{"name": "sda", "maj_min": "8:0", "rm": 0, "size": "100G", "ro": 0, "type": "disk", "mountpoints": ""}, {"name": "sda1", "maj_min": "8:1", "rm": 0, "size": "512M", "ro": 0, "type": "part", "mountpoints": "/boot/efi"}])
end

def test_blkid_parse():
  assert_eq(blkid_parse("/dev/sda1: UUID=\"abc-1\" TYPE=\"ext4\" PARTUUID=\"p-1\""), [{"device": "/dev/sda1", "uuid": "abc-1", "type": "ext4", "partuuid": "p-1"}])
end

def test_lsmod_parse():
  assert_eq(lsmod_parse("Module Size Used by\nnf_tables 250000 5 nft_ct,nft_chain\nvfat 20480 1"), [{"module": "nf_tables", "size": 250000, "used": 5, "used_by": "nft_ct,nft_chain"}, {"module": "vfat", "size": 20480, "used": 1, "used_by": ""}])
end

def test_lspci_and_lsusb_parse():
  assert_eq(lspci_parse("00:1f.2 SATA controller: Intel Corporation 82801"), [{"slot": "00:1f.2", "class": "SATA controller", "description": "Intel Corporation 82801"}])
  | assert_eq(lsusb_parse("Bus 001 Device 002: ID 8087:0024 Intel Corp. Hub"), [{"bus": "001", "device": "002", "id": "8087:0024", "description": "Intel Corp. Hub"}])
end

def test_dmesg_parse_seconds_and_dates():
  assert_eq(dmesg_parse("[   12.345678] usb 1-1: new device\n[Sat Sep 20 12:00:00 2026] eth0: link up"), [{"time": 12.345678, "message": "usb 1-1: new device"}, {"time": "Sat Sep 20 12:00:00 2026", "message": "eth0: link up"}])
end

def test_syslog_parse_classic_and_iso():
  assert_eq(syslog_parse("Sep 20 12:00:01 web sshd[123]: Accepted key\n2026-09-20T12:00:02+0900 web kernel: oops"), [{"timestamp": "Sep 20 12:00:01", "host": "web", "process": "sshd", "message": "Accepted key", "pid": 123}, {"timestamp": "2026-09-20T12:00:02+0900", "host": "web", "process": "kernel", "message": "oops"}])
end

def test_systemctl_parse_drops_footer_and_marker():
  assert_eq(systemctl_parse("  UNIT LOAD ACTIVE SUB DESCRIPTION\n● foo.service loaded failed failed Foo daemon\n  ssh.service loaded active running OpenBSD Secure Shell server\n\n2 loaded units listed."), [{"unit": "foo.service", "load": "loaded", "active": "failed", "sub": "failed", "description": "Foo daemon"}, {"unit": "ssh.service", "load": "loaded", "active": "active", "sub": "running", "description": "OpenBSD Secure Shell server"}])
  | assert_eq(systemctl_parse("UNIT FILE STATE PRESET\nssh.service enabled enabled\n\n1 unit files listed."), [{"unit_file": "ssh.service", "state": "enabled", "preset": "enabled"}])
end

def test_ldd_parse_found_missing_and_loader():
  assert_eq(ldd_parse("\tlibc.so.6 => /lib/libc.so.6 (0x00007f00)\n\tlibx.so => not found\n\t/lib64/ld-linux-x86-64.so.2 (0x00007f11)"), [{"name": "libc.so.6", "path": "/lib/libc.so.6", "address": "0x00007f00"}, {"name": "libx.so", "path": None}, {"name": "ld-linux-x86-64.so.2", "path": "/lib64/ld-linux-x86-64.so.2", "address": "0x00007f11"}])
end

def test_traceroute_parse_resolved_silent_and_numeric_hops():
  assert_eq(traceroute_parse(" 1  gw (192.168.1.1)  1.2 ms  1.1 ms\n 2  * * *\n 3  10.0.0.1  5.5 ms"), [{"hop": 1, "rtts": [1.2, 1.1], "host": "gw", "ip": "192.168.1.1"}, {"hop": 2, "rtts": []}, {"hop": 3, "rtts": [5.5], "ip": "10.0.0.1"}])
end

def test_dig_parse_answer_records():
  assert_eq(dig_parse(";; ANSWER SECTION:\nexample.com.\t300\tIN\tA\t93.184.216.34\nexample.com. 300 IN MX 10 mail.example.com."), [{"name": "example.com.", "ttl": 300, "class": "IN", "type": "A", "data": "93.184.216.34"}, {"name": "example.com.", "ttl": 300, "class": "IN", "type": "MX", "data": "10 mail.example.com."}])
end

def test_curl_headers_parse_uses_last_response():
  assert_eq(curl_headers_parse("HTTP/1.1 301 Moved Permanently\r\nLocation: /x\r\n\r\nHTTP/2 200\r\nContent-Type: text/html\r\n\r\n"), {"http_version": "2", "status": 200, "headers": {"content-type": "text/html"}})
  | assert_eq(curl_headers_parse("not http"), {})
end

def test_ssh_keygen_parse():
  assert_eq(ssh_keygen_parse("256 SHA256:abc alice@host (ED25519)"), [{"bits": 256, "fingerprint": "SHA256:abc", "comment": "alice@host", "type": "ED25519"}])
end

def test_passwd_and_group_parse():
  assert_eq(passwd_parse("# c\nroot:x:0:0:root:/root:/bin/bash"), [{"user": "root", "password": "x", "uid": 0, "gid": 0, "comment": "root", "home": "/root", "shell": "/bin/bash"}])
  | assert_eq(group_parse("staff:*:20:alice,bob\nnobody:*:-2:"), [{"name": "staff", "password": "*", "gid": 20, "members": ["alice", "bob"]}])
end

def test_hosts_parse_skips_comments():
  assert_eq(hosts_parse("# hosts\n127.0.0.1 localhost lo # loopback\n\n::1 ip6-localhost"), [{"ip": "127.0.0.1", "hostname": "localhost", "aliases": ["lo"]}, {"ip": "::1", "hostname": "ip6-localhost", "aliases": []}])
end

def test_os_release_parse_unquotes():
  assert_eq(os_release_parse("# c\nNAME=\"Ubuntu\"\nID=ubuntu\nQ='x y'"), {"NAME": "Ubuntu", "ID": "ubuntu", "Q": "x y"})
end

def test_time_parse_bash_and_posix():
  assert_eq(time_parse("real\t1m2.500s\nuser\t0m0.250s\nsys\t0m0.100s"), {"real": 62.5, "user": 0.25, "sys": 0.1})
  | assert_eq(time_parse("real 1.23\nuser 0.5\nsys 0.1"), {"real": 1.23, "user": 0.5, "sys": 0.1})
end

def test_detect_finds_unique_signature():
  assert_eq(detect("uid=501(alice) gid=20(staff)"), ["id"])
  | assert_eq(detect("USER PID %CPU %MEM VSZ RSS TT STAT STARTED TIME COMMAND\nroot 1 0 0 1 1 ?? Ss 9:00 0:00 init"), ["ps"])
  | assert_eq(detect("hello world"), [])
end

def test_detect_never_claims_generic_formats():
  assert_eq(detect("1 3 6 a.txt"), [])
  | assert_eq(detect(" M src/a.rs\n?? b.txt"), [])
end

def test_parse_auto_parses_when_unique():
  assert_eq(parse_auto("uid=0(root) gid=0(root)"), {"uid": 0, "user": "root", "gid": 0, "group": "root"})
  | assert_eq(parse_auto("2 packets transmitted, 2 received, 0% packet loss")["received"], 2)
end

def test_parse_auto_errors_when_nothing_matches():
  assert_eq(try: parse_auto("hello world") catch: "error", "error")
end

def test_parse_auto_errors_when_ambiguous():
  let text = "State Recv-Q Send-Q Local Address:Port Peer Address:Port\ntcp4 0 0 127.0.0.1.80 *.* LISTEN"
  | assert_eq(detect(text), ["netstat", "ss"])
  | assert_eq(try: parse_auto(text) catch: "error", "error")
end

def test_detect_refuses_text_that_mixes_formats():
  assert_eq(detect("uid=1(a) gid=1(a)\n-rw-r--r--  1 a staff 12 Jan  1 12:00 f"), [])
end

def test_parser_key_uses_subcommand_and_aliases():
  assert_eq(_parser_key("git", ["-C", "x", "log", "-2"]), "git log")
  | assert_eq(_parser_key("/usr/bin/pip3", ["list"]), "pip list")
  | assert_eq(_parser_key("kubectl", ["-n", "prod", "get", "pods"]), "kubectl get")
  | assert_eq(_parser_key("podman", ["ps"]), "docker ps")
  | assert_eq(_parser_key("yum", ["list", "installed"]), "dnf list")
  | assert_eq(_parser_key("ps", ["aux"]), "ps")
end

def test_parse_output_resolves_aliases_and_rejects_unknown_subcommands():
  assert_eq(parse_output("md5sum", "d41d8cd98f00b204e9800998ecf8427e  a"), [{"hash": "d41d8cd98f00b204e9800998ecf8427e", "file": "a"}])
  | assert_eq(parse_output("ip a", "lo UNKNOWN 127.0.0.1/8")[0]["name"], "lo")
  | assert_eq(try: parse_output("git blame", "x") catch: "error", "error")
end

def test_parse_output_reaches_generic_git_formats_by_name():
  assert_eq(parse_output("git log --oneline", "abc1234 fix bug"), [{"commit": "abc1234", "message": "fix bug"}])
  | assert_eq(parse_output("git diff --numstat", "1\t2\ta.rs"), [{"added": 1, "deleted": 2, "path": "a.rs"}])
end

