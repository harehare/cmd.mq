# Parses `git diff --numstat` into added, deleted and path. Binary files
# have None counts.
#
# Example:
# ```
# import "cmd" | cmd::git_diff_numstat_parse("12\t3\tsrc/a.rs\n-\t-\timg.png")
# #=> [{"added": 12, "deleted": 3, "path": "src/a.rs"}, {"added": None, "deleted": None, "path": "img.png"}]
# ```
#
# Returns: array
def git_diff_numstat_parse(input):
  _by_key("git diff --numstat", input)
end

# Parses `git diff --stat` into files (path and changes, or binary: true) and
# the summary counts files_changed, insertions and deletions.
#
# Example:
# ```
# import "cmd" | cmd::git_diff_stat_parse(" src/a.rs | 5 ++---\n 1 file changed, 2 insertions(+), 3 deletions(-)")
# #=> {"files": [{"path": "src/a.rs", "changes": 5}], "files_changed": 1, "insertions": 2, "deletions": 3}
# ```
#
# Returns: dict
def git_diff_stat_parse(input):
  let lines = _lines(input)
  | let files = map(filter(map(lines, fn(line): capture(line, "^\\s*(?<path>.+?)\\s+\\|\\s+(?<changes>\\d+|Bin)\\b");), fn(m): !is_empty(keys(m));), fn(m): if (m["changes"] == "Bin"): {"path": m["path"], "binary": true} else: {"path": m["path"], "changes": to_number(m["changes"])};)
  | let total = capture(input, "(?<files>\\d+) files? changed")
  | let ins = capture(input, "(?<n>\\d+) insertions?\\(\\+\\)")
  | let del = capture(input, "(?<n>\\d+) deletions?\\(-\\)")
  | {"files": files, "files_changed": if (is_empty(keys(total))): 0 else: to_number(total["files"]), "insertions": if (is_empty(keys(ins))): 0 else: to_number(ins["n"]), "deletions": if (is_empty(keys(del))): 0 else: to_number(del["n"])}
end

