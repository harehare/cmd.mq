    {"key": "git blame --line-porcelain", "sig": "\\A\\^?[0-9a-f]{40}(?:[0-9a-f]{24})? \\d+ \\d+(?: \\d+)?\\n", "parse": {"type": "blocks", "start": "^\\^?[0-9a-f]{40}(?:[0-9a-f]{24})? \\d+ \\d+(?: \\d+)?$", "require": ["commit", "content"], "captures": [{"re": "(?m)^\\^?(?<commit>[0-9a-f]{40}(?:[0-9a-f]{24})?) (?<original_line>\\d+) (?<final_line>\\d+)(?: (?<group_size>\\d+))?$"}, {"re": "(?m)^author (?<author>.*)$"}, {"re": "(?m)^author-mail <(?<author_mail>.*)>$"}, {"re": "(?m)^author-time (?<author_time>\\d+)$"}, {"re": "(?m)^author-tz (?<author_tz>.*)$"}, {"re": "(?m)^committer (?<committer>.*)$"}, {"re": "(?m)^committer-mail <(?<committer_mail>.*)>$"}, {"re": "(?m)^committer-time (?<committer_time>\\d+)$"}, {"re": "(?m)^committer-tz (?<committer_tz>.*)$"}, {"re": "(?m)^summary (?<summary>.*)$"}, {"re": "(?m)^filename (?<filename>.*)$"}, {"re": "(?m)^previous (?<previous>.*)$"}, {"re": "(?m)^(?<boundary>boundary)$"}, {"re": "(?m)^\\t(?<content>[^\\n]*)$"}]}, "fields": {"original_line": {"type": "int"}, "final_line": {"type": "int"}, "group_size": {"type": "int"}, "author_time": {"type": "int"}, "committer_time": {"type": "int"}, "boundary": {"type": "bool", "true_values": ["boundary"]}, "content": {"keep_empty": true}}},
