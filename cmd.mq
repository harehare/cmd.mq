    {"key": "git worktree", "sig": None, "parse": {"type": "regex", "patterns": ["^(?<path>.+?)\\s+(?<commit>[0-9a-f]{7,40})\\s+(?:\\[(?<branch>[^\\]]+)\\]|\\((?<state>[^)]+)\\))"]}},
