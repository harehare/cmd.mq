    {"key": "taskset", "sig": "\\Apid \\d+'s (?:current|new) affinity (?:mask|list): [^\\n]+\\n*\\z", "parse": {"type": "regex", "single": true, "patterns": ["^pid (?<pid>\\d+)'s (?<state>current|new) affinity (?<format>mask|list): (?<affinity>\\S+)$"]}, "fields": {"pid": {"type": "int"}}},
