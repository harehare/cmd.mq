    {"key": "getcap", "sig": _shape("\\S+\\s+(?:=\\s+)?cap_\\S[^\\n]*"), "parse": {"type": "regex", "patterns": ["^(?<path>\\S+)\\s+(?:=\\s+)?(?<capabilities>cap_\\S.*)$"], "trim": true}},
    {"key": "host", "sig": _shape("\\S+ (?:has address \\S+|has IPv6 address \\S+|is an alias for \\S+|mail is handled by \\d+ \\S+|descriptive text \"[^\\n]*\"|name server \\S+|domain name pointer \\S+)"), "parse": {"type": "regex", "patterns": [{"re": "^(?<name>\\S+) has address (?<value>\\S+)$", "set": {"type": "A"}}, {"re": "^(?<name>\\S+) has IPv6 address (?<value>\\S+)$", "set": {"type": "AAAA"}}, {"re": "^(?<name>\\S+) is an alias for (?<value>\\S+)$", "set": {"type": "CNAME"}}, {"re": "^(?<name>\\S+) mail is handled by (?<priority>\\d+) (?<value>\\S+)$", "set": {"type": "MX"}}, {"re": "^(?<name>\\S+) descriptive text \"(?<value>.*)\"$", "set": {"type": "TXT"}}, {"re": "^(?<name>\\S+) name server (?<value>\\S+)$", "set": {"type": "NS"}}, {"re": "^(?<name>\\S+) domain name pointer (?<value>\\S+)$", "set": {"type": "PTR"}}], "trim": true}, "fields": {"priority": {"type": "int"}}},
    {"key": "nslookup", "sig": "\\AServer:\\s+\\S", "parse": {"type": "record", "require": ["server"], "captures": [{"re": "Server:\\s+(?<server>\\S+)"}, {"re": "Address:\\s+(?<server_address>\\S+)"}, {"into": "answers", "blocks": {"type": "blocks", "start": "^Name:", "require": ["name"], "captures": [{"re": "^Name:\\s+(?<name>\\S+)"}, {"re": "(?m)^Address:\\s+(?<value>\\S+)", "all": true, "values": true, "into": "addresses"}]}}]}},
