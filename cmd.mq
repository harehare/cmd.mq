# Parses `stat` output. macOS/BSD prints one line per file in the default
# format, and GNU prints a `File:` block per file. Both give one dict per
# file: BSD has path, device, inode, mode, links, owner, group, rdev, size,
# atime, mtime, ctime, birthtime, blksize, blocks and flags, and GNU has file,
# size, blocks, io_block, type, device, inode, links, mode, permissions, uid,
# user, gid, group, access, modify, change and birth.
#
# Example:
# ```
# import "cmd" | cmd::stat_parse("1 2 -rw-r--r-- 1 root wheel 0 230 \"Aug 15 11:07:33 2026\" \"Aug 15 11:07:33 2026\" \"Sep 15 21:14:34 2026\" \"Aug  2 08:15:31 2026\" 4096 8 0 /etc/hosts")[0]["size"]
# #=> 230
# ```
#
# Returns: array
def stat_parse(input):
  _by_key("stat", input)
end

# Returns the regex (without capture groups) of one `last` line or footer.
def _last_line_re():
  "\\S+\\s+\\S+\\s+(?:\\S.*?\\s+)?[A-Z][a-z]{2} [A-Z][a-z]{2}\\s+\\d{1,2} \\d{2}:\\d{2}(?::\\d{2})?(?: \\d{4})?(?:\\s+[^\\n]*)?|(?:wtmp|btmp) begins[^\\n]*"
end

