    {"key": "curl", "sig": "\\AHTTP/\\d", "parse": {"type": "blocks", "start": "^HTTP/", "last": true, "replace": [["\\r", ""]], "require": ["status"], "captures": [{"re": "^HTTP/(?<http_version>\\S+) (?<status>\\d{3})(?: (?<reason>.*))?"}, {"re": "(?m)^(?<key>[^:\\s]+):\\s*(?<value>.*)$", "all": true, "merge": true, "into": "headers"}]}, "fields": {"status": {"type": "int"}}},
    {"key": "ssh-keygen", "sig": _shape("\\d+ (?:SHA256|MD5):\\S+ [^\\n]* \\([A-Z0-9-]+\\)"), "parse": {"type": "regex", "patterns": ["^(?<bits>\\d+) (?<fingerprint>\\S+) (?<comment>.*) \\((?<type>[^)]+)\\)$"]}, "fields": {"bits": {"type": "int"}}},
    {"key": "passwd", "sig": _shape("#[^\\n]*|[^:\\s#][^:\\n]*:[^:\\n]*:\\d+:\\d+:[^:\\n]*:[^:\\n]*:[^:\\n]*"), "parse": {"type": "regex", "patterns": ["^(?<user>[^:]*):(?<password>[^:]*):(?<uid>\\d+):(?<gid>\\d+):(?<comment>[^:]*):(?<home>[^:]*):(?<shell>.*)$"], "skip": ["^#"], "keep_empty": true}, "fields": {"uid": {"type": "int"}, "gid": {"type": "int"}}},
    {"key": "group", "sig": _shape("#[^\\n]*|[^:\\s#][^:\\n]*:[^:\\n]*:\\d+:[^:\\n]*"), "parse": {"type": "regex", "patterns": ["^(?<name>[^:]*):(?<password>[^:]*):(?<gid>\\d+):(?<members>.*)$"], "skip": ["^#"], "keep_empty": true}, "fields": {"gid": {"type": "int"}, "members": {"type": "array", "split": ","}}},
    {"key": "hosts", "sig": None, "parse": {"type": "regex", "trim": true, "replace": [["(?m)#.*$", ""]], "patterns": ["^(?<ip>\\S+)\\s+(?<hostname>\\S+)(?:\\s+(?<aliases>.*))?$"]}, "fields": {"aliases": {"type": "array", "split": "\\s+", "default": []}}},
