    {"key": "unzip", "sig": "^\\s*Length\\s+Date\\s+Time\\s+Name", "parse": {"type": "regex", "patterns": ["^\\s*(?<size>\\d+)\\s+(?<date>\\S+)\\s+(?<time>\\d{2}:\\d{2})\\s+(?<name>.*)$"]}, "fields": {"size": {"type": "int"}}},
    {"key": "tar", "sig": None, "parse": {"type": "choice", "options": [{"when": "^[-dlbcps][-rwxsStT]{9} \\S+\\s+\\d+ \\d{4}-\\d{2}-\\d{2}", "parse": {"type": "regex", "patterns": ["^(?<permissions>[-dlbcps][-rwxsStT]{9}) (?<owner>\\S+)\\s+(?<size>\\d+) (?<modified>\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}(?::\\d{2})?) (?<name>.*)$"]}, "fields": {"size": {"type": "int"}}}, {"parse": {"type": "regex", "patterns": ["^(?<permissions>[l]\\S{9,10})\\s+(?<links>\\d+)\\s+(?<owner>\\S+)\\s+(?<group>\\S+)\\s+(?<size>\\d+)\\s+(?<modified>\\w{3}\\s+\\d{1,2}\\s+(?:\\d{2}:\\d{2}|\\d{4}))\\s+(?<name>.*?) -> (?<link_target>.*)$", "^(?<permissions>[-dlbcps]\\S{9,10})\\s+(?<links>\\d+)\\s+(?<owner>\\S+)\\s+(?<group>\\S+)\\s+(?<size>\\d+)\\s+(?<modified>\\w{3}\\s+\\d{1,2}\\s+(?:\\d{2}:\\d{2}|\\d{4}))\\s+(?<name>.*)$"]}, "fields": {"links": {"type": "int"}, "size": {"type": "int"}, "modified": {"squeeze": true}, "type": {"derive": {"op": "prefix", "from": "permissions", "map": {"d": "directory", "l": "symlink", "-": "file"}, "default": "other"}}}}]}},
    {"key": "grep", "sig": None, "parse": {"type": "regex", "patterns": ["^(?<file>[^:]+):(?<line>\\d+):(?<text>.*)$", "^(?<file>[^:]+):(?<text>.*)$"]}, "fields": {"line": {"type": "int"}, "text": {"keep_empty": true}}},
    {"key": "file", "sig": None, "parse": {"type": "regex", "patterns": ["^(?<path>.+?): (?<description>.*)$"]}},
    {"key": "checksum", "sig": _shape("(?:[0-9a-f]{32}|[0-9a-f]{40}|[0-9a-f]{56}|[0-9a-f]{64}|[0-9a-f]{96}|[0-9a-f]{128}) [ *][^\\n]+|(?:MD5|SHA\\d+) \\([^\\n]*\\) = [0-9a-f]+"), "parse": {"type": "regex", "patterns": ["^(?<algorithm>[A-Za-z0-9-]+) \\((?<file>.*)\\) = (?<hash>[0-9a-fA-F]+)$", "^(?<hash>[0-9a-fA-F]{32,128}) [ *](?<file>.*)$"]}},
    {"key": "pgrep", "sig": None, "parse": {"type": "regex", "patterns": ["^(?<pid>\\d+)(?: (?<name>.*))?$"], "trim": true}, "fields": {"pid": {"type": "int"}}},
