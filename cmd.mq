# Command output parsers implemented in mq.
#
# Turns the text printed by common CLI commands (ps, df, ls -l, git log, ...)
# into arrays of dicts, so it can be filtered with mq or rendered as JSON
# or a Markdown table. Generic parsers (columns_parse, table_parse, kv_parse)
# keep every value as a string. Command-specific parsers convert only the
# fields that are plainly numeric.

# Returns the non-blank lines of the input.
def _lines(input):
  filter(split(input, "\n"), fn(line): trim(line) != "";)
end

# Converts a string to a number only when it is a plain integer or decimal.
def _num(value):
  if (is_string(value) && is_regex_match(value, "^-?\\d+(\\.\\d+)?$")): to_number(value) else: value
end

# Normalizes a header name: lowercase, `%cpu` -> `cpu_percent`, `Use%` -> `use_percent`,
# and `/` or spaces -> `_`.
def _key(name):
  let lower = gsub(gsub(gsub(gsub(downcase(name), "/", "_"), " ", "_"), ":", "_"), "@", "")
  | if (starts_with(lower, "%")): slice(lower, 1, len(lower)) + "_percent"
    elif (ends_with(lower, "%")): slice(lower, 0, len(lower) - 1) + "_percent"
    else: lower
end

# Pairs header names with row values. Missing values become empty strings.
def _zip_dict(header, row):
  if (is_empty(header)): {}
  else: dict(map(range(len(header) - 1), fn(i): [header[i], if (i < len(row)): row[i] else: ""];))
end

# Splits a line on whitespace into at most n fields. The last field keeps
# the rest of the line as is, so values with spaces survive.
def _split_n(line, n):
  let tokens = split(line, "\\s+")
  | if (len(tokens) <= n): tokens
    else:
      do
        let rest = capture(line, "^(?:\\S+\\s+){" + to_string(n - 1) + "}(?<rest>.*)$")["rest"]
        | add(slice(tokens, 0, n - 1), [rest])
      end
end

# Parses whitespace-separated columns with a header line into an array of
# dicts. The last column takes the rest of each line, so it may contain
# spaces (e.g. the COMMAND column of `ps`).
#
# The first line is always treated as the header. Pass `headers` (an array
# of names) to replace the header names, e.g. when a name contains a space.
#
# Example:
# ```
# import "cmd" | cmd::columns_parse("PID CMD\n1 init -x\n2 sh")
# #=> [{"PID": "1", "CMD": "init -x"}, {"PID": "2", "CMD": "sh"}]
# ```
#
# Returns: array
def columns_parse(input, headers = None):
  let lines = _lines(input)
  | if (is_empty(lines)): []
    else:
      do
        let names = if (is_none(headers)): split(trim(first(lines)), "\\s+") else: headers
        | let n = len(names)
        | map(slice(lines, 1, len(lines)), fn(line): _zip_dict(names, _split_n(trim(line), n));)
      end
end

# Returns the start offset of each column in an aligned header line.
# A column starts at a non-space character that follows two spaces (or the
# line start), so header names with a single space ("CONTAINER ID") stay whole.
def _column_starts(header):
  filter(range(len(header) - 1), fn(i):
    slice(header, i, i + 1) != " "
      && (i == 0 || (slice(header, i - 1, i) == " " && (i == 1 || slice(header, i - 2, i - 1) == " ")));
  )
end

# Cuts a line into fields at the given column start offsets.
def _cut_at(line, starts):
  map(range(len(starts) - 1), fn(i):
    let from = starts[i]
    | let to = if (i + 1 < len(starts)): starts[i + 1] else: len(line)
    | trim(slice(line, from, to));
  )
end

# Parses a table whose columns are aligned under the header line, cutting
# each row at the header's column offsets. Use it for output whose values
# contain spaces, such as `docker ps` or `kubectl get`.
#
# Example:
# ```
# import "cmd" | cmd::table_parse("NAME   STATUS\nweb    Up 2 hours")
# #=> [{"NAME": "web", "STATUS": "Up 2 hours"}]
# ```
#
# Returns: array
def table_parse(input):
  let lines = _lines(input)
  | if (is_empty(lines)): []
    else:
      do
        let header = first(lines)
        | let starts = _column_starts(header)
        | let names = _cut_at(header, starts)
        | map(slice(lines, 1, len(lines)), fn(line): _zip_dict(names, _cut_at(line, starts));)
      end
end

# Parses `key<sep>value` lines into a single dict. Lines without the
# separator are skipped. Only the first separator splits, so values may
# contain it. Use `"="` for `env` output.
#
# Example:
# ```
# import "cmd" | cmd::kv_parse("Name: Alice\nTime: 12:30")
# #=> {"Name": "Alice", "Time": "12:30"}
# ```
#
# Returns: dict
def kv_parse(input, sep = ":"):
  let lines = filter(split(input, "\n"), fn(line): index(line, sep) > 0;)
  | dict(map(lines, fn(line):
      let i = index(line, sep)
      | [trim(slice(line, 0, i)), trim(slice(line, i + len(sep), len(line)))];
    ))
end

# Parses blank-line separated `key<sep>value` blocks into an array of dicts.
#
# Example:
# ```
# import "cmd" | cmd::kv_blocks_parse("a: 1\n\na: 2")
# #=> [{"a": "1"}, {"a": "2"}]
# ```
#
# Returns: array
def kv_blocks_parse(input, sep = ":"):
  split(input, "\n\\s*\n")
  | map(fn(block): kv_parse(block, sep);)
  | filter(fn(d): !is_empty(keys(d));)
end

# Parses `ps aux` / `ps -ef` output. Keys are lowercased header names and
# pid, ppid, cpu_percent, mem_percent, vsz and rss are numbers.
#
# Example:
# ```
# import "cmd" | cmd::ps_parse("USER PID %CPU COMMAND\nroot 1 0.5 /sbin/init")
# #=> [{"user": "root", "pid": 1, "cpu_percent": 0.5, "command": "/sbin/init"}]
# ```
#
# Returns: array
def ps_parse(input):
  _by_key("ps", input)
end

# Parses `df` output. Keys are lowercased header names (`Mounted on` becomes
# `mounted_on`) and every column except filesystem and mounted_on is a number
# when it is a plain integer (`df -k`, `df -P`). Human-readable sizes such as
# "460Gi" stay strings.
#
# Example:
# ```
# import "cmd" | cmd::df_parse("Filesystem 1K-blocks Used Available Use% Mounted on\n/dev/sda1 100 40 60 40% /")
# #=> [{"filesystem": "/dev/sda1", "1k-blocks": 100, "used": 40, "available": 60, "use_percent": "40%", "mounted_on": "/"}]
# ```
#
# Returns: array
def df_parse(input):
  _by_key("df", input)
end

# Parses `du` output into `size` and `path`. The size is a number when it is
# a plain integer (`du -k`), and stays a string for `du -h` (e.g. "4.0K").
#
# Example:
# ```
# import "cmd" | cmd::du_parse("8\t./src\n16\t.")
# #=> [{"size": 8, "path": "./src"}, {"size": 16, "path": "."}]
# ```
#
# Returns: array
def du_parse(input):
  _by_key("du", input)
end

# Parses `ls -l` / `ls -la` output. The `total` line and lines that are not
# entries are skipped. Each entry has type, permissions, links, owner, group,
# size, modified and name, plus link_target for symlinks.
#
# Example:
# ```
# import "cmd" | cmd::ls_parse("-rw-r--r--  1 alice staff 12 Jan  1 12:00 a.txt")
# #=> [{"type": "file", "permissions": "-rw-r--r--", "links": 1, "owner": "alice", "group": "staff", "size": 12, "modified": "Jan 1 12:00", "name": "a.txt"}]
# ```
#
# Returns: array
def ls_parse(input):
  _by_key("ls", input)
end

# Parses the default `git log` format into an array of commits with commit,
# author, date and message, plus merge and refs when present.
#
# Example:
# ```
# import "cmd" | cmd::git_log_parse("commit abc123\nAuthor: A <a@x.dev>\nDate:   Mon Jan 1 12:00:00 2024 +0000\n\n    fix bug\n")
# #=> [{"commit": "abc123", "author": "A <a@x.dev>", "date": "Mon Jan 1 12:00:00 2024 +0000", "message": "fix bug"}]
# ```
#
# Returns: array
def git_log_parse(input):
  _by_key("git log", input)
end

# Parses `git status --porcelain` (or `--short`) into one dict per changed
# path with the raw `index` and `worktree` status codes and the `path`.
# Renames also have `orig_path`. Branch lines (`-b`) are skipped, and
# quoted paths are kept as printed.
#
# Example:
# ```
# import "cmd" | cmd::git_status_parse(" M src/a.rs\n?? new.txt")
# #=> [{"index": " ", "worktree": "M", "path": "src/a.rs"}, {"index": "?", "worktree": "?", "path": "new.txt"}]
# ```
#
# Returns: array
def git_status_parse(input):
  _by_key("git status", input)
end

# Parses `git branch` into `name` and `current`. With `-v`, each branch also
# has `commit` and `message`.
#
# Example:
# ```
# import "cmd" | cmd::git_branch_parse("* main\n  dev")
# #=> [{"name": "main", "current": true}, {"name": "dev", "current": false}]
# ```
#
# Returns: array
def git_branch_parse(input):
  _by_key("git branch", input)
end

# Parses `id` output into uid, user, gid, group and groups (an array of
# {"id", "name"}). Returns an empty dict when the input is not `id` output.
#
# Example:
# ```
# import "cmd" | cmd::id_parse("uid=501(alice) gid=20(staff) groups=20(staff),12(everyone)")
# #=> {"uid": 501, "user": "alice", "gid": 20, "group": "staff", "groups": [{"id": 20, "name": "staff"}, {"id": 12, "name": "everyone"}]}
# ```
#
# Returns: dict
def id_parse(input):
  _by_key("id", input)
end

# Parses default `wc` output (lines, words, bytes) into one dict per line,
# with `file` when a file name is printed (including the `total` line).
#
# Example:
# ```
# import "cmd" | cmd::wc_parse("  1  3  6 a.txt")
# #=> [{"lines": 1, "words": 3, "bytes": 6, "file": "a.txt"}]
# ```
#
# Returns: array
def wc_parse(input):
  _by_key("wc", input)
end

# Parses the summary of `ping` (macOS and Linux) into transmitted, received
# and loss_percent, plus rtt_min, rtt_avg, rtt_max and rtt_stddev in
# milliseconds when replies arrived. Returns an empty dict without a summary.
#
# Example:
# ```
# import "cmd" | cmd::ping_parse("2 packets transmitted, 2 packets received, 0.0% packet loss\nround-trip min/avg/max/stddev = 0.6/0.9/1.1/0.2 ms")
# #=> {"transmitted": 2, "received": 2, "loss_percent": 0, "rtt_min": 0.6, "rtt_avg": 0.9, "rtt_max": 1.1, "rtt_stddev": 0.2}
# ```
#
# Returns: dict
def ping_parse(input):
  _by_key("ping", input)
end

# Parses `lsof` output. Keys are lowercased header names (`SIZE/OFF` becomes
# `size_off`) and pid is a number. NAME keeps the rest of the line.
#
# Example:
# ```
# import "cmd" | cmd::lsof_parse("COMMAND PID USER FD NAME\nzsh 42 alice cwd /tmp/my dir")
# #=> [{"command": "zsh", "pid": 42, "user": "alice", "fd": "cwd", "name": "/tmp/my dir"}]
# ```
#
# Returns: array
def lsof_parse(input):
  _by_key("lsof", input)
end

# Parses Linux `free` output into one dict per row (`Mem`, `Swap`) with
# `type` and the lowercased column names (`buff/cache` becomes `buff_cache`).
# Values are numbers, except `free -h` sizes such as "15Gi".
#
# Example:
# ```
# import "cmd" | cmd::free_parse("       total  used  free\nMem:    100    40    60\nSwap:    10     0    10")
# #=> [{"type": "Mem", "total": 100, "used": 40, "free": 60}, {"type": "Swap", "total": 10, "used": 0, "free": 10}]
# ```
#
# Returns: array
def free_parse(input):
  _by_key("free", input)
end

# Returns the start offset of each column in a `-----  -----` separator line.
def _dash_starts(line):
  filter(range(len(line) - 1), fn(i): slice(line, i, i + 1) == "-" && (i == 0 || slice(line, i - 1, i) == " ");)
end

# Parses `pip list` output. The dashed separator line gives the column
# offsets, so header names with spaces ("Editable project location") work.
# Keys are lowercased with spaces replaced by underscores, and versions
# stay strings.
#
# Example:
# ```
# import "cmd" | cmd::pip_list_parse("Package Version\n------- -------\npip     26.1.1")
# #=> [{"package": "pip", "version": "26.1.1"}]
# ```
#
# Returns: array
def pip_list_parse(input):
  _by_key("pip list", input)
end

# Returns the lines from the first one matching `pattern` to the end, or an
# empty array when no line matches.
def _from_match(lines, pattern):
  let hits = filter(range(len(lines) - 1), fn(i): is_regex_match(lines[i], pattern);)
  | if (is_empty(hits)): [] else: slice(lines, hits[0], len(lines))
end

# Groups lines into blocks. A line matching `pattern` starts a new block, and
# lines before the first such line are dropped.
def _group_lines(lines, pattern):
  fold(lines, [], fn(acc, line):
    if (is_regex_match(line, pattern)): add(acc, [[line]])
    elif (is_empty(acc)): acc
    else: add(slice(acc, 0, len(acc) - 1), [add(last(acc), [line])]);
  )
end

# Returns the non-blank lines of the input, trimmed.
#
# Example:
# ```
# import "cmd" | cmd::lines_parse("a\n\n b \n")
# #=> ["a", "b"]
# ```
#
# Returns: array
def lines_parse(input):
  _by_key("lines", input)
end

# Parses `uniq -c` output into count and value.
#
# Example:
# ```
# import "cmd" | cmd::uniq_c_parse("  3 foo\n  1 bar baz")
# #=> [{"count": 3, "value": "foo"}, {"count": 1, "value": "bar baz"}]
# ```
#
# Returns: array
def uniq_c_parse(input):
  _by_key("uniq", input)
end

# Parses `grep -n` / `grep -rn` output into file, line and text. Without
# `-n` the line number is omitted. Lines without a file prefix are skipped.
#
# Example:
# ```
# import "cmd" | cmd::grep_parse("a.rs:12:let x = 1;")
# #=> [{"file": "a.rs", "line": 12, "text": "let x = 1;"}]
# ```
#
# Returns: array
def grep_parse(input):
  _by_key("grep", input)
end

# Parses `file` output into path and description.
#
# Example:
# ```
# import "cmd" | cmd::file_parse("a.txt: ASCII text")
# #=> [{"path": "a.txt", "description": "ASCII text"}]
# ```
#
# Returns: array
def file_parse(input):
  _by_key("file", input)
end

# Parses `md5`, `shasum`, `sha256sum` and similar output into hash and file
# (plus algorithm for the BSD `MD5 (file) = hash` format).
#
# Example:
# ```
# import "cmd" | cmd::checksum_parse("d41d8cd98f00b204e9800998ecf8427e  empty.txt")
# #=> [{"hash": "d41d8cd98f00b204e9800998ecf8427e", "file": "empty.txt"}]
# ```
#
# Returns: array
def checksum_parse(input):
  _by_key("checksum", input)
end

# Parses `pgrep` / `pgrep -l` / `pgrep -fl` output into pid and name.
#
# Example:
# ```
# import "cmd" | cmd::pgrep_parse("123 zsh\n456")
# #=> [{"pid": 123, "name": "zsh"}, {"pid": 456}]
# ```
#
# Returns: array
def pgrep_parse(input):
  _by_key("pgrep", input)
end

# Parses `arp -a` output into host, ip, mac and interface.
#
# Example:
# ```
# import "cmd" | cmd::arp_parse("? (192.168.1.1) at aa:bb:cc:dd:ee:ff on en0 ifscope [ethernet]")
# #=> [{"host": "?", "ip": "192.168.1.1", "mac": "aa:bb:cc:dd:ee:ff", "interface": "en0"}]
# ```
#
# Returns: array
def arp_parse(input):
  _by_key("arp", input)
end

# Parses `uptime` (macOS and Linux) into time, uptime, users, load_1, load_5
# and load_15. Returns an empty dict when the input is not `uptime` output.
#
# Example:
# ```
# import "cmd" | cmd::uptime_parse("12:34  up 5 days,  3:21, 2 users,  load averages: 1.23 1.45 1.67")
# #=> {"time": "12:34", "uptime": "5 days,  3:21", "users": 2, "load_1": 1.23, "load_5": 1.45, "load_15": 1.67}
# ```
#
# Returns: dict
def uptime_parse(input):
  _by_key("uptime", input)
end

# Parses `who` output into user, tty, login and host (when printed).
#
# Example:
# ```
# import "cmd" | cmd::who_parse("alice ttys000 Sep 20 12:01 (10.0.0.5)")
# #=> [{"user": "alice", "tty": "ttys000", "login": "Sep 20 12:01", "host": "10.0.0.5"}]
# ```
#
# Returns: array
def who_parse(input):
  _by_key("who", input)
end

# Parses the table of `w` (the uptime line is skipped). Keys are lowercased
# header names, with `LOGIN@` becoming `login`.
#
# Example:
# ```
# import "cmd" | cmd::w_parse("12:34 up 1 day\nUSER TTY FROM LOGIN@ IDLE WHAT\nalice ttys000 - 09:00 1 -zsh")
# #=> [{"user": "alice", "tty": "ttys000", "from": "-", "login": "09:00", "idle": "1", "what": "-zsh"}]
# ```
#
# Returns: array
def w_parse(input):
  _by_key("w", input)
end

# Parses `mount` output into device, mount_point, type and options (an
# array). On macOS the type is the first option in parentheses.
#
# Example:
# ```
# import "cmd" | cmd::mount_parse("sysfs on /sys type sysfs (rw,nosuid)")
# #=> [{"device": "sysfs", "mount_point": "/sys", "type": "sysfs", "options": ["rw", "nosuid"]}]
# ```
#
# Returns: array
def mount_parse(input):
  _by_key("mount", input)
end

# Parses `uname -a` (macOS and Linux) into kernel_name, node_name,
# kernel_release, kernel_version and machine. Returns an empty dict for fewer than 5 fields.
#
# Example:
# ```
# import "cmd" | cmd::uname_parse("Linux host 5.15.0 #1 SMP Mon x86_64 x86_64 x86_64 GNU/Linux")
# #=> {"kernel_name": "Linux", "node_name": "host", "kernel_release": "5.15.0", "kernel_version": "#1 SMP Mon", "machine": "x86_64"}
# ```
#
# Returns: dict
def uname_parse(input):
  _by_key("uname", input)
end

# Parses `sysctl` output (`key: value` on macOS, `key = value` on Linux) into
# one dict. Values stay strings, and lines that are not a single-line
# key/value pair are skipped.
#
# Example:
# ```
# import "cmd" | cmd::sysctl_parse("hw.ncpu: 12\nkernel.ostype = Linux")
# #=> {"hw.ncpu": "12", "kernel.ostype": "Linux"}
# ```
#
# Returns: dict
def sysctl_parse(input):
  _by_key("sysctl", input)
end

# Parses macOS `vm_stat` output into a dict of numbers. Keys are lowercased
# with underscores (`Pages free` becomes `pages_free`), plus `page_size`.
#
# Example:
# ```
# import "cmd" | cmd::vm_stat_parse("Mach Virtual Memory Statistics: (page size of 16384 bytes)\nPages free:    100.")
# #=> {"page_size": 16384, "pages_free": 100}
# ```
#
# Returns: dict
def vm_stat_parse(input):
  _by_key("vm_stat", input)
end

# Parses Linux `vmstat` output. The second header line (`r b swpd ...`) names
# the columns, and every value is a number.
#
# Example:
# ```
# import "cmd" | cmd::vmstat_parse("procs ---memory---\n r  b  free\n 1  0  100")
# #=> [{"r": 1, "b": 0, "free": 100}]
# ```
#
# Returns: array
def vmstat_parse(input):
  _by_key("vmstat", input)
end

# Parses the process table of `top` (macOS `top -l 1` or Linux `top -bn1`),
# skipping the summary lines. Keys are lowercased header names, and pid,
# cpu_percent and mem_percent are numbers when plain.
#
# Example:
# ```
# import "cmd" | cmd::top_parse("load avg\n  PID USER %CPU COMMAND\n  1 root 0.5 init")
# #=> [{"pid": 1, "user": "root", "cpu_percent": 0.5, "command": "init"}]
# ```
#
# Returns: array
def top_parse(input):
  _by_key("top", input)
end

# Parses `launchctl list` (macOS) into pid, status and label. A pid of `-`
# (not running) becomes None.
#
# Example:
# ```
# import "cmd" | cmd::launchctl_list_parse("PID\tStatus\tLabel\n-\t0\tcom.example.job\n123\t0\tcom.example.run")
# #=> [{"pid": None, "status": 0, "label": "com.example.job"}, {"pid": 123, "status": 0, "label": "com.example.run"}]
# ```
#
# Returns: array
def launchctl_list_parse(input):
  _by_key("launchctl", input)
end

# Parses `ifconfig` (macOS and net-tools) into one dict per interface with
# name, flags (array), mtu, ether, status, ipv4 (array of {address,
# netmask}) and ipv6 (array of {address, prefixlen}).
#
# Example:
# ```
# import "cmd" | cmd::ifconfig_parse("lo0: flags=8049<UP,LOOPBACK> mtu 16384\n\tinet 127.0.0.1 netmask 0xff000000")
# #=> [{"name": "lo0", "flags": ["UP", "LOOPBACK"], "mtu": 16384, "ipv4": [{"address": "127.0.0.1", "netmask": "0xff000000"}], "ipv6": []}]
# ```
#
# Returns: array
def ifconfig_parse(input):
  _by_key("ifconfig", input)
end

# Parses `netstat -an` / `netstat -tulpn` connection lines into proto, recv_q,
# send_q, local_address, foreign_address, and state and program when printed.
# Header, unix socket and routing lines are skipped.
#
# Example:
# ```
# import "cmd" | cmd::netstat_parse("tcp4 0 0 127.0.0.1.8080 *.* LISTEN")
# #=> [{"proto": "tcp4", "recv_q": 0, "send_q": 0, "local_address": "127.0.0.1.8080", "foreign_address": "*.*", "state": "LISTEN"}]
# ```
#
# Returns: array
def netstat_parse(input):
  _by_key("netstat", input)
end

# Strips one pair of surrounding double or single quotes from a string.
def _unquote(value):
  if (is_string(value) && len(value) >= 2 && ((starts_with(value, "\"") && ends_with(value, "\"")) || (starts_with(value, "'") && ends_with(value, "'")))): slice(value, 1, len(value) - 1) else: value
end

# Parses macOS `mdls` output (`key = value`) into a dict. Quotes are removed,
# `(null)` becomes None, and multi-line values are skipped.
#
# Example:
# ```
# import "cmd" | cmd::mdls_parse("kMDItemKind = \"Text\"\nkMDItemNote = (null)")
# #=> {"kMDItemKind": "Text", "kMDItemNote": None}
# ```
#
# Returns: dict
def mdls_parse(input):
  _by_key("mdls", input)
end

# Parses macOS `otool -L` output into path, compatibility_version and current_version.
#
# Example:
# ```
# import "cmd" | cmd::otool_l_parse("/bin/ls:\n\t/usr/lib/libSystem.B.dylib (compatibility version 1.0.0, current version 1351.0.0)")
