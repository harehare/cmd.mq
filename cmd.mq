    {"key": "lsblk", "sig": "\\ANAME\\s+(?:MAJ:MIN|FSTYPE|RM\\b)|\\ANAME\\b[^\\n]*\\bMOUNTPOINTS?\\b", "parse": {"type": "columns", "strip": "^[├└│─ ]+"}, "fields": {"rm": {"type": "int"}, "ro": {"type": "int"}}},
    {"key": "blkid", "sig": _shape("/[^:\\n]+: [^\\n]*\\w+=\"[^\"\\n]*\"[^\\n]*"), "parse": {"type": "blocks", "start": "^\\S", "require": ["device"], "captures": [{"re": "^(?<device>[^:]+):"}, {"re": "(?<key>\\w+)=\"(?<value>[^\"]*)\"", "all": true, "merge": true}]}},
    {"key": "lsmod", "sig": "\\AModule\\s+Size\\s+Used by", "parse": {"type": "columns", "headers": ["module", "size", "used", "used_by"]}, "fields": {"size": {"type": "int"}, "used": {"type": "int"}}},
    {"key": "lspci", "sig": _shape("(?:[0-9a-f]{4}:)?[0-9a-f]{2}:[0-9a-f]{2}\\.\\d [^:\\n]+: [^\\n]+"), "parse": {"type": "regex", "patterns": ["^(?<slot>\\S+) (?<class>[^:]+): (?<description>.*)$"]}},
    {"key": "lsusb", "sig": _shape("Bus \\d{3} Device \\d{3}: ID [0-9a-f]{4}:[0-9a-f]{4}(?: [^\\n]*)?"), "parse": {"type": "regex", "patterns": ["^Bus (?<bus>\\d+) Device (?<device>\\d+): ID (?<id>[0-9a-f]{4}:[0-9a-f]{4})(?: (?<description>.*))?$"]}},
    {"key": "dmesg", "sig": _shape("\\[\\s*\\d+\\.\\d+\\] [^\\n]*|\\[[A-Za-z]{3} [A-Za-z]{3}\\s+\\d+ [\\d:]+ \\d{4}\\] [^\\n]*"), "parse": {"type": "regex", "patterns": ["^\\[\\s*(?<time>[\\d.]+)\\] (?<message>.*)$", "^\\[(?<time>[A-Za-z]{3} [A-Za-z]{3}\\s+\\d+ [\\d:]+ \\d{4})\\] (?<message>.*)$"]}, "fields": {"time": {"type": "float"}}},
    {"key": "syslog", "sig": _shape("(?:\\w{3}\\s+\\d+ \\d\\d:\\d\\d:\\d\\d|\\d{4}-\\d{2}-\\d{2}T\\S+) \\S+ [^\\s\\[:]+(?:\\[\\d+\\])?: [^\\n]*"), "parse": {"type": "regex", "patterns": ["^(?<timestamp>\\w{3}\\s+\\d+\\s+[\\d:]+|\\d{4}-\\d{2}-\\d{2}T\\S+)\\s+(?<host>\\S+)\\s+(?<process>[^\\[:\\s]+)(?:\\[(?<pid>\\d+)\\])?:\\s+(?<message>.*)$"]}, "fields": {"pid": {"type": "int"}}},
    {"key": "systemctl", "sig": "\\A\\s*UNIT(?: FILE)?\\s+(?:LOAD|STATE)", "parse": {"type": "columns", "replace": [["(?m)^[●○×*]\\s+", "  "], ["UNIT FILE", "UNIT_FILE"]], "until_blank": true}},
    {"key": "ldd", "sig": _shape("[ \\t]*\\S+ (?:=> \\S+ )?\\(0x[0-9a-f]+\\)|[ \\t]*\\S+ => not found"), "parse": {"type": "regex", "patterns": ["^\\s*(?<name>\\S+) => (?<path>\\S+) \\((?<address>0x[0-9a-f]+)\\)$", {"re": "^\\s*(?<name>\\S+) => not found$", "set": {"path": None}}, "^\\s*(?<path>\\S+) \\((?<address>0x[0-9a-f]+)\\)$"]}, "fields": {"name": {"derive": {"op": "basename", "from": "path"}}}},
    {"key": "traceroute", "sig": "^\\s*\\d+\\s+\\S+(?: \\([0-9a-f.:]+\\))?\\s+[\\d.]+ ms", "parse": traceroute_parse},
