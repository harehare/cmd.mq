    {"key": "sw_vers", "sig": "\\AProductName:\\s+", "parse": {"type": "kv", "separator": ":"}},
    {"key": "lscpu", "sig": "\\AArchitecture:\\s+\\S+", "parse": {"type": "kv", "separator": ":"}},
