    {"key": "stat", "sig": "\\A\\s+File: |" + _shape("\\d+ \\d+ \\S+ \\d+ \\S+ \\S+ \\d+ \\d+ \"[^\"]*\" \"[^\"]*\" \"[^\"]*\" \"[^\"]*\" \\d+ \\d+ \\S+ [^\\n]*"), "parse": {"type": "choice", "options": [{"when": "\\A\\s+File: ", "parse": {"type": "blocks", "start": "^\\s+File: ", "require": ["file"], "captures": [{"re": "File: (?<file>[^\\n]+)"}, {"re": "Size: (?<size>\\d+)\\s+Blocks: (?<blocks>\\d+)\\s+IO Block: (?<io_block>\\d+)\\s+(?<type>[^\\n]+)"}, {"re": "Device: (?<device>\\S+)\\s+Inode: (?<inode>\\d+)\\s+Links: (?<links>\\d+)"}, {"re": "Access: \\((?<mode>\\d+)/(?<permissions>\\S+)\\)\\s+Uid: \\(\\s*(?<uid>\\d+)/\\s*(?<user>\\S+)\\)\\s+Gid: \\(\\s*(?<gid>\\d+)/\\s*(?<group>\\S+)\\)"}, {"re": "Access: (?<access>\\d{4}-[^\\n]+)"}, {"re": "Modify: (?<modify>[^\\n]+)"}, {"re": "Change: (?<change>[^\\n]+)"}, {"re": "Birth: (?<birth>\\d[^\\n]*)"}]}, "fields": {"size": {"type": "int"}, "blocks": {"type": "int"}, "io_block": {"type": "int"}, "inode": {"type": "int"}, "links": {"type": "int"}, "uid": {"type": "int"}, "gid": {"type": "int"}, "type": {"trim": true}}}, {"parse": {"type": "regex", "patterns": ["^(?<device>\\d+) (?<inode>\\d+) (?<mode>\\S+) (?<links>\\d+) (?<owner>\\S+) (?<group>\\S+) (?<rdev>\\d+) (?<size>\\d+) \"(?<atime>[^\"]*)\" \"(?<mtime>[^\"]*)\" \"(?<ctime>[^\"]*)\" \"(?<birthtime>[^\"]*)\" (?<blksize>\\d+) (?<blocks>\\d+) (?<flags>\\S+) (?<path>.*)$"]}, "fields": {"device": {"type": "int"}, "inode": {"type": "int"}, "links": {"type": "int"}, "rdev": {"type": "int"}, "size": {"type": "int"}, "blksize": {"type": "int"}, "blocks": {"type": "int"}}}]}},
    {"key": "last", "sig": _shape(_last_line_re()), "parse": {"type": "regex", "patterns": ["^(?<user>\\S+)\\s+(?<tty>\\S+)\\s+(?:(?<host>\\S.*?)\\s+)?(?<login>[A-Z][a-z]{2} [A-Z][a-z]{2}\\s+\\d{1,2} \\d{2}:\\d{2}(?::\\d{2})?(?: \\d{4})?)(?:\\s+(?<session>.*))?$"], "skip": ["^(?:wtmp|btmp) begins"]}},
    {"key": "route", "sig": "^Destination\\s+Gateway\\s+Genmask\\s+Flags\\s+Metric", "parse": {"type": "columns", "start_at": "^Destination\\s+Gateway"}, "fields": {"metric": {"type": "int"}, "ref": {"type": "int"}, "use": {"type": "int"}}},
    {"key": "route get", "sig": "\\A\\s*route to:", "parse": {"type": "kv", "separator": ":"}},
    {"key": "zipinfo", "sig": "\\AArchive:[^\\n]*\\nZip file size:", "parse": {"type": "regex", "patterns": ["^(?<permissions>[-dlrwxsStT]{10})\\s+(?<version>[\\d.]+)\\s+(?<os>\\S+)\\s+(?<size>\\d+)\\s+(?<flags>\\S+)\\s+(?<method>\\S+)\\s+(?<date>\\S+)\\s+(?<time>\\d{2}:\\d{2})\\s+(?<name>.*)$"]}, "fields": {"size": {"type": "int"}}},
    {"key": "gzip", "sig": "\\A\\s*compressed\\s+uncompressed\\s+ratio", "parse": {"type": "columns"}, "fields": {"compressed": {"type": "int"}, "uncompressed": {"type": "int"}}},
    {"key": "hexdump", "sig": _shape("[0-9a-f]{8}(?:  (?:[0-9a-f]{2} ?)+ +\\|[^\\n]*\\|)?|\\*"), "parse": {"type": "regex", "patterns": ["^(?<offset>[0-9a-f]{8})\\s+(?<bytes>(?:[0-9a-f]{2} ?)+)\\s+\\|(?<ascii>.*)\\|$"]}, "fields": {"bytes": {"remove": " "}, "ascii": {"keep_empty": true}}},
    {"key": "cksum", "sig": None, "parse": {"type": "regex", "patterns": ["^(?<checksum>\\d+)\\s+(?<size>\\d+)(?:\\s+(?<file>.*))?$"], "trim": true}, "fields": {"checksum": {"type": "int"}, "size": {"type": "int"}}},
    {"key": "tree", "sig": "^\\d+ director(?:y|ies)(?:, \\d+ files?)?$", "parse": {"type": "tree", "pattern": "^(?<indent>(?:│   |    )*)[├└]── (?<name>.*)$", "unit": 4, "path": true}},
    {"key": "getconf", "sig": None, "parse": {"type": "regex", "as": "map", "trim": true, "patterns": ["^(?<key>[A-Za-z_0-9]+):?\\s*(?<value>.*)$"]}, "fields": {"*": {"type": "int"}}},
    {"key": "diskutil list", "sig": "\\A/dev/disk\\d+ \\(", "parse": {"type": "blocks", "start": "^/dev/", "require": ["device"], "captures": [{"re": "^(?<device>/dev/\\S+) \\((?<description>[^)]*)\\):"}, {"re": "(?m)^[ \\t]+(?<index>\\d+):[ \\t]+(?<type>\\S+)[ \\t]+(?<name>.*?)[ \\t]+(?<size>\\*?[\\d.]+ [KMGTP]?B)[ \\t]+(?<identifier>disk\\S+)$", "all": true, "into": "partitions", "keep_empty": true, "fields": {"index": {"type": "int"}}}]}},
    {"key": "diskutil info", "sig": "^\\s+Device Identifier:", "parse": {"type": "kv", "separator": ":"}},
    {"key": "pmset batt", "sig": "\\ANow drawing from '", "parse": {"type": "record", "require": ["source"], "captures": [{"re": "Now drawing from '(?<source>[^']*)'"}, {"re": "(?m)^[ \\t]*-(?<name>\\S+) \\(id=(?<id>\\d+)\\)[ \\t]+(?<percent>\\d+)%; (?<state>[^;]+)(?:; (?<remaining>[^;]*?))? present: (?<present>\\w+)$", "all": true, "into": "batteries", "fields": {"id": {"type": "int"}, "percent": {"type": "int"}, "state": {"trim": true}, "present": {"type": "bool", "true_values": ["true"], "false_values": ["false"]}}}]}},
