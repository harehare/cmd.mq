    {"key": "locale", "sig": None, "parse": {"type": "kv", "separator": "=", "unquote": true, "skip": ["^\\s*#"]}},
    {"key": "time", "sig": "\\Areal\\s+\\S+\\s*\\n(?:user|sys)\\s+", "parse": time_parse},
