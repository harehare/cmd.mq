end

# Converts shell `time` output (`real 0m1.234s` or the POSIX `real 1.23`) to
# seconds.
#
# Example:
# ```
# import "cmd" | cmd::time_parse("real\t0m1.500s\nuser\t0m0.250s\nsys\t0m0.100s")
# #=> {"real": 1.5, "user": 0.25, "sys": 0.1}
# ```
#
# Returns: dict
def time_parse(input):
  let rows = filter(map(_lines(input), fn(line): capture(trim(line), "^(?<name>real|user|sys)\\s+(?:(?<min>\\d+)m)?(?<sec>[\\d.]+)s?$");), fn(m): !is_empty(keys(m));)
  | dict(map(rows, fn(m): [m["name"], (if (is_none(m["min"])): 0 else: to_number(m["min"]) * 60) + to_number(m["sec"])];))
end

# Parses `snap list` into lowercased keys with a numeric rev.
#
# Example:
# ```
# import "cmd" | cmd::snap_list_parse("Name Version Rev Tracking Publisher Notes\ncore20 20240111 2182 latest/stable canonical** base")
# #=> [{"name": "core20", "version": "20240111", "rev": 2182, "tracking": "latest/stable", "publisher": "canonical**", "notes": "base"}]
# ```
#
# Returns: array
def snap_list_parse(input):
  _by_key("snap list", input)
end

