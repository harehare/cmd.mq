    {"key": "git shortlog", "sig": None, "parse": {"type": "regex", "patterns": ["^\\s*(?<commits>\\d+)\\s+(?<author>.*?)(?: <(?<email>[^>]*)>)?$"]}, "fields": {"commits": {"type": "int"}}},
    {"key": "git remote", "sig": _shape("\\S+\\s+\\S+ \\((?:fetch|push)\\)"), "parse": {"type": "regex", "patterns": ["^(?<name>\\S+)\\s+(?<url>\\S+) \\((?<direction>fetch|push)\\)$"]}},
    {"key": "git stash", "sig": _shape("stash@\\{\\d+\\}: [^\\n]*"), "parse": {"type": "regex", "patterns": ["^(?<ref>stash@\\{(?<index>\\d+)\\}): (?:WIP on|On) (?<branch>[^:]+): (?<message>.*)$", "^(?<ref>stash@\\{(?<index>\\d+)\\}): (?<message>.*)$"]}, "fields": {"index": {"type": "int"}}},
    {"key": "git reflog", "sig": _shape("[0-9a-f]{7,40} (?:\\([^)\\n]*\\) )?\\S+@\\{\\d+\\}: [^\\n]*"), "parse": {"type": "regex", "patterns": ["^(?<commit>[0-9a-f]{7,40}) (?:\\([^)]*\\) )?(?<ref>\\S+@\\{\\d+\\}): (?<action>[^:]+)(?:: (?<message>.*))?$"]}},
