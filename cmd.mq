def ldd_parse(input):
  _by_key("ldd", input)
end

# Parses one `traceroute` hop line.
def _hop_entry(line):
  let m = capture(line, "^\\s*(?<hop>\\d+)\\s+(?<rest>.*)$")
  | if (is_empty(keys(m))): m
    else:
      do
        let rtts = map(regex_match(m["rest"], "[\\d.]+ ms"), fn(s): to_number(slice(s, 0, len(s) - 3));)
        | let first_token = first(split(trim(m["rest"]), "\\s+"))
        | let paren = capture(m["rest"], "\\((?<ip>[^)]+)\\)")
        | let base = {"hop": to_number(m["hop"]), "rtts": rtts}
        | if (first_token == "*"): base
          elif (is_empty(keys(paren))): set(base, "ip", first_token)
          else: set(set(base, "host", first_token), "ip", paren["ip"])
      end
end

# Parses `traceroute` into hop, host (when resolved), ip and rtts (an array of
# milliseconds) for the first responder of each hop. A hop with no reply has empty rtts.
#
# Example:
# ```
# import "cmd" | cmd::traceroute_parse(" 1  gw (192.168.1.1)  1.2 ms  1.1 ms")
# #=> [{"hop": 1, "rtts": [1.2, 1.1], "host": "gw", "ip": "192.168.1.1"}]
# ```
#
# Returns: array
def traceroute_parse(input):
  map(_lines(input), _hop_entry)
  | filter(fn(entry): !is_empty(keys(entry));)
end

