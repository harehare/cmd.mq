# Builds a signature for text made only of lines matching `pattern` (blank
# lines allowed), anchored at both ends of the window.
def _shape(pattern):
  let p = "(?:" + pattern + ")"
  | "\\A\\n*(?:" + p + "\\n+)*" + p + "\\n*\\z"
end

# Reads rustup's installed marker while keeping unmarked entries explicit.
def _rustup_items():
  {"type": "regex", "patterns": ["^(?<name>\\S+) \\((?<installed>installed)\\)$", "^(?<name>\\S+)$"]}
end

# Definition engine. A registry entry describes a parser as data: `parse` is
# a spec dict (or a function for formats the engine cannot express), and
# `fields` holds the per-field rules. Adding a command means adding an entry.
#
# Spec types:
#   regex      one dict per line, from the named groups of `patterns` (the
#              first pattern that matches wins; a pattern is a string or
#              {"re": ..., "set": {constants}}). `trim` trims each line first,
#              `single: true` returns one dict (or {}) instead of an array, and
#              `as: "map"` turns rows with `key` and `value` groups into one
#              dict (`normalize_keys: true` lowercases the keys).
#   columns    whitespace columns under a header line, the last column takes
#              the rest of the line. `headers` replaces the header names,
#              `prefix_headers` adds names for columns the header leaves
#              unnamed, and `header: false` says there is no header line.
#   aligned    columns cut at the header's offsets (two or more spaces between
#              names, or `offsets: "dashes"` for a `---- ----` separator line).
#              `keys: "raw"` keeps the header names as printed.
#   delimited  rows split on `separator` (default tab) under a header line.
#   kv         one dict from `key<separator>value` lines (`blocks: true` gives
#              an array of dicts from blank-line separated blocks, `unquote`
#              removes surrounding quotes).
#   words      one dict per line of words: the first word is `first`, a word in
#              `keys` takes the next word as its value, other words go to a
#              `flags` array (`prefix_types` lists words that may come first).
#   lines      the trimmed non-blank lines.
#   record     one dict from the first match of every pattern over the whole
#              text (`require` lists the keys that must be captured), or from
#              `captures`.
#   blocks     one dict per block, where a line matching `start` begins a
#              block. Each block is read by `captures`, a list of
#              {"re": ...} entries: a plain one adds the groups of its first
#              match, and {"re": ..., "all": true, "into": key} collects every
#              match into an array (`values: true` keeps only the `value`
#              group, `join` makes a string, `fields` types the rows, `merge`
#              builds a dict from `key`/`value` groups, `within` limits the
#              text, and `blocks` nests another blocks spec). `last: true`
#              returns only the last block as one dict.
#   choice     the first of `options` ({"when": regex, "parse": spec, "fields":
#              rules}) whose `when` matches the text.
#   indent     nested dicts from an indented listing: a line with a deeper
#              line after it is a section, the others are `key<separator>value`
#              (`unquote` removes quotes around keys and values).
#   tree       one dict per line of a glyph tree: `pattern` has an `indent`
#              group, `unit` is the indent width per level, `base` the depth of
#              the first level, and `path: true` adds the path from `name`.
#
# Input options for every type: `replace` ([[regex, text], ...] on the whole
# text), `start_at` (drop the lines before the first match), `until_blank`
# (keep the first block only), `strip` (regex removed from each line) and
# `skip` (regexes of lines to ignore).
#
# Field rules, keyed by the field name (`*` matches any other field):
# `type` (int and float turn plain numbers into numbers, bool, array,
# string), `null_if`, `trim_suffix`, `remove`, `true_values`, `false_values`,
# `split`, `rename`, `trim`, `squeeze` (collapse whitespace), `default` and
# `derive` (both fill a missing field; `derive` is {"op": "prefix"|"basename",
# "from": field, ...}) and `keep_empty`.

# Converts a bool by the rule's true_values and false_values.
def _convert_bool(text, rule):
  if (has(rule, "true_values") && contains(rule["true_values"], text)): true
  elif (has(rule, "false_values") && contains(rule["false_values"], text)): false
  else: text
end

# Converts an array by splitting on the rule's `split` regex (default a comma).
def _convert_array(text, rule):
  if (text == ""): [] else: split(text, if (has(rule, "split")): rule["split"] else: ",\\s*")
end

# Applies one field rule to a string value.
def _convert(value, rule):
  let raw = if (has(rule, "trim") && rule["trim"]): trim(value) else: value
  | let removed = if (has(rule, "remove")): gsub(raw, rule["remove"], "") else: raw
  | let text = if (has(rule, "squeeze") && rule["squeeze"]): gsub(removed, "\\s+", " ") else: removed
  | let cut = if (has(rule, "trim_suffix") && ends_with(text, rule["trim_suffix"])): slice(text, 0, len(text) - len(rule["trim_suffix"])) else: text
  | let kind = if (has(rule, "type")): rule["type"] else: "string"
  | if (has(rule, "null_if") && contains(rule["null_if"], cut)): None
    elif (kind == "int" || kind == "float"): _num(cut)
    elif (kind == "bool"): _convert_bool(cut, rule)
    elif (kind == "array"): _convert_array(cut, rule)
    else: cut
end

# Applies the field rule of one key. Returns [key, value], or None when an
# empty string is dropped.
def _field_pair(key, value, fields, keep):
  let rule = if (has(fields, key)): fields[key] elif (has(fields, "*")): fields["*"] else: None
  | let converted = if (is_none(rule) || !is_string(value)): value else: _convert(value, rule)
  | let out_key = if (!is_none(rule) && has(rule, "rename")): rule["rename"] else: key
  | let keep_it = if (!is_none(rule) && has(rule, "keep_empty")): rule["keep_empty"] else: keep
  | if (is_string(converted) && converted == "" && !keep_it): None else: [out_key, converted]
end

# Computes a derived field from another field of the row. `prefix` maps the
# first character of the source (with a `default`), and `basename` takes the
# last path component.
def _derive(row, rule):
  let source = row[rule["from"]]
  | if (rule["op"] == "basename"): basename(source)
    elif (has(rule["map"], slice(source, 0, 1))): rule["map"][slice(source, 0, 1)]
    else: rule["default"]
end

# Adds the value of one rule to a row when the field is missing: the `default`,
# or the result of `derive` when its source field is a string.
def _fill(acc, key, rule):
  if (!is_dict(rule) || has(acc, key)): acc
  elif (has(rule, "derive") && has(acc, rule["derive"]["from"]) && is_string(acc[rule["derive"]["from"]])): set(acc, key, _derive(acc, rule["derive"]))
  elif (has(rule, "default")): set(acc, key, rule["default"])
  else: acc
end

# Applies the field rules to a row, then fills the fields that are missing
# with their `default` or `derive` rule.
def _apply_fields(row, fields, keep):
  let done = dict(filter(map(entries(row), fn(kv): _field_pair(kv[0], kv[1], fields, keep);), fn(pair): !is_none(pair);))
  | fold(entries(fields), done, fn(acc, kv): _fill(acc, kv[0], kv[1]);)
end

# Returns the spec's `keep_empty` option, or the default for its type.
def _keep_empty(spec, default):
  if (has(spec, "keep_empty")): spec["keep_empty"] else: default
end

# Returns true when a line matches one of the spec's `skip` regexes.
def _skipped(spec, line):
  has(spec, "skip") && contains(map(spec["skip"], fn(re): is_regex_match(line, re);), true)
end

# Returns the input text after the spec's `replace` and `until_blank` options.
def _spec_text(spec, output):
  let replaced = fold(if (has(spec, "replace")): spec["replace"] else: [], output, fn(acc, pair): gsub(acc, pair[0], pair[1]);)
  | if (has(spec, "until_blank") && spec["until_blank"]): first(split(trim(replaced), "\n\\s*\n")) else: replaced
end

# Returns the non-blank lines of the input after the spec's input options.
def _spec_lines(spec, output):
  let all = split(_spec_text(spec, output), "\n")
  | let started = if (has(spec, "start_at")): _from_match(all, spec["start_at"]) else: all
  | let stripped = if (has(spec, "strip")): map(started, fn(line): gsub(line, spec["strip"], "");) else: started
  | let trimmed = if (has(spec, "trim") && spec["trim"]): map(stripped, trim) else: stripped
  | filter(trimmed, fn(line): trim(line) != "" && !_skipped(spec, line);)
end

# Matches a line against one pattern (a string or {"re", "set"}).
def _match_pattern(line, pattern):
  let re = if (is_string(pattern)): pattern else: pattern["re"]
  | let m = capture(line, re)
  | if (is_empty(keys(m)) || is_string(pattern) || !has(pattern, "set")): m else: m + pattern["set"]
end

# Returns the captures of the first pattern that matches the line, or {}.
def _match_line(line, patterns):
  let hits = filter(map(patterns, fn(p): _match_pattern(line, p);), fn(m): !is_empty(keys(m));)
  | if (is_empty(hits)): {} else: hits[0]
end

# Returns the key of a `key`/`value` row, normalized when the spec asks for it.
def _row_key(spec, key):
  if (has(spec, "normalize_keys") && spec["normalize_keys"]): _key(key) else: key
end

def _spec_regex(spec, fields, output):
  let patterns = if (has(spec, "patterns")): spec["patterns"] else: [spec["pattern"]]
  | let rows = filter(map(_spec_lines(spec, output), fn(line): _match_line(line, patterns);), fn(m): !is_empty(keys(m));)
  | if (has(spec, "as") && spec["as"] == "map"): dict(filter(map(rows, fn(m): _field_pair(_row_key(spec, m["key"]), m["value"], fields, _keep_empty(spec, true));), fn(pair): !is_none(pair);))
    else:
      do
        let done = map(rows, fn(m): _apply_fields(m, fields, _keep_empty(spec, false));)
        | if (has(spec, "single") && spec["single"]): if (is_empty(done)): {} else: first(done)
          else: done
      end
end

# Joins the values of a capture into a string, trimmed when the capture asks.
def _joined(values, cap):
  let text = join(values, cap["join"])
  | if (has(cap, "trim") && cap["trim"]): trim(text) else: text
end

# Shapes the rows of an `all` capture: the `value` group of each row (`values`,
# turned into numbers with `type: "int"`), or the rows as dicts with the
# capture's own `fields`. `join` turns the values into one string.
def _capture_value(cap, rows):
  let shaped = if (has(cap, "values") && cap["values"]): map(rows, fn(r): if (has(cap, "type")): _num(r["value"]) else: r["value"];) else: map(rows, fn(r): _apply_fields(r, if (has(cap, "fields")): cap["fields"] else: {}, has(cap, "keep_empty") && cap["keep_empty"]);)
  | if (has(cap, "join")): _joined(shaped, cap) else: shaped
end

# Collects every match of an `all` capture: an array under `into`, or with
# `merge` one dict from the `key` and `value` groups (keys normalized), placed
# under `into` when it is given.
def _capture_all(text, cap):
  let rows = map(regex_match(text, cap["re"]), fn(m): capture(m, cap["re"]);)
  | if (has(cap, "merge") && cap["merge"]): if (has(cap, "into")): set({}, cap["into"], dict(map(rows, fn(r): [_key(r["key"]), r["value"]];))) else: dict(map(rows, fn(r): [_key(r["key"]), r["value"]];))
    else: set({}, cap["into"], _capture_value(cap, rows))
end

# Applies one capture to a text. A plain capture gives the groups of its first
# match, and `all` collects every match. `within` restricts the capture to the
# `value` group of another regex (nothing is captured when that one does not
# match), and `blocks` reads the text as nested blocks under `into`.
def _capture_apply(text, cap):
  let scope = if (has(cap, "within")): capture(text, cap["within"]) else: None
  | let source = if (is_none(scope)): text elif (has(scope, "value")): scope["value"] else: None
  | if (is_none(source)): {}
    elif (has(cap, "blocks")): set({}, cap["into"], _spec_blocks(cap["blocks"], if (has(cap, "fields")): cap["fields"] else: {}, source))
    elif (has(cap, "all") && cap["all"]): _capture_all(source, cap)
    else: capture(source, cap["re"])
end

# Merges the captures of a text into one dict. Returns {} unless every key in
# `require` was captured.
def _capture_block(text, spec, fields):
  let merged = fold(spec["captures"], {}, fn(acc, cap): acc + _capture_apply(text, cap);)
  | let needed = if (has(spec, "require")): spec["require"] else: []
  | if (!is_empty(filter(needed, fn(k): !has(merged, k);))): {}
    else: _apply_fields(merged, fields, _keep_empty(spec, false))
end

# Reads a text as one dict, from `captures` or from the first match of every pattern.
def _spec_record(spec, fields, output):
  let text = _spec_text(spec, output)
  | if (has(spec, "captures")): _capture_block(text, spec, fields)
    else:
      do
        let merged = fold(spec["patterns"], {}, fn(acc, p): acc + capture(text, if (is_string(p)): p else: p["re"]);)
        | let needed = if (has(spec, "require")): spec["require"] else: []
        | if (!is_empty(filter(needed, fn(k): !has(merged, k);))): {}
          else: _apply_fields(merged, fields, _keep_empty(spec, false))
      end
end

# Splits the text into blocks that start at a line matching `start`, and reads
# every block as one dict from `captures`. Blocks without every `require` key are dropped.
def _spec_blocks(spec, fields, output):
  let groups = _group_lines(filter(split(_spec_text(spec, output), "\n"), fn(line): !_skipped(spec, line);), spec["start"])
  | let blocks = filter(map(groups, fn(g): _capture_block(join(g, "\n"), spec, fields);), fn(d): !is_empty(keys(d));)
  | if (has(spec, "last") && spec["last"]): if (is_empty(blocks)): {} else: last(blocks)
    else: blocks
end

# Runs the first option whose `when` regex matches the text (an option without
# `when` matches anything). Each option has its own `parse` and `fields`.
def _spec_choice(spec, fields, output):
  let hits = filter(spec["options"], fn(o): !has(o, "when") || is_regex_match(output, "(?m)" + o["when"]);)
  | if (is_empty(hits)): []
    else:
      do
        let o = first(hits)
        | _run_spec(o["parse"], if (has(o, "fields")): o["fields"] else: {}, output)
      end
end

# Reads one line of an indented listing as {"indent", "key", "value"}. A line
# without the separator is a header with an empty value.
def _indent_item(line, sep, unquote):
  let body = trim(line)
  | let indent = len(line) - len(ltrim(line))
  | let i = index(body, sep)
  | let shape = fn(text): if (unquote): _unquote(text) else: text;
  | if (i > 0): {"indent": indent, "key": shape(trim(slice(body, 0, i))), "value": shape(trim(slice(body, i + len(sep), len(body))))}
    else: {"indent": indent, "key": shape(body), "value": ""}
end

# Marks the items that have deeper items after them as sections.
def _indent_sections(items):
  if (is_empty(items)): []
  else: map(range(len(items) - 1), fn(i): set(items[i], "section", i + 1 < len(items) && items[i + 1]["indent"] > items[i]["indent"]);)
end

# Adds the path of the enclosing section names to every item.
def _indent_paths(items):
  fold(items, {"stack": [], "out": []}, fn(acc, it):
    let stack = filter(acc["stack"], fn(s): s[0] < it["indent"];)
    | let next_stack = if (it["section"]): add(stack, [[it["indent"], it["key"]]]) else: stack
    | {"stack": next_stack, "out": add(acc["out"], [set(it, "path", map(stack, fn(s): s[1];))])};
  )["out"]
end

# Builds a nested dict from items with paths: the items whose path is exactly
# `depth` deep are leaves, and the longer paths are grouped by the section
# name at `depth`.
def _indent_nest(items, depth, spec):
  let leaves = filter(items, fn(it): len(it["path"]) == depth && !it["section"];)
  | let children = filter(items, fn(it): len(it["path"]) > depth;)
  | let names = uniq(map(children, fn(it): it["path"][depth];))
  | let base = dict(map(leaves, fn(it): [_row_key(spec, it["key"]), it["value"]];))
  | fold(names, base, fn(acc, name): set(acc, _row_key(spec, name), _indent_nest(filter(children, fn(it): it["path"][depth] == name;), depth + 1, spec));)
end

# Reads an indented listing (`Section:` headers with `Key: value` lines under
# them) into nested dicts. Indentation only has to be deeper for children.
def _spec_indent(spec, fields, output):
  let sep = if (has(spec, "separator")): spec["separator"] else: ":"
  | let unquote = has(spec, "unquote") && spec["unquote"]
  | let items = _indent_paths(_indent_sections(map(_spec_lines(spec, output), fn(line): _indent_item(line, sep, unquote);)))
  | _indent_nest(items, 0, spec)
end



def _spec_columns(spec, fields, output):
  let lines = _spec_lines(spec, output)
  | if (is_empty(lines)): []
    else:
      do
        let with_header = !(has(spec, "header") && spec["header"] == false)
        | let names = if (has(spec, "headers")): spec["headers"] elif (with_header): add(if (has(spec, "prefix_headers")): spec["prefix_headers"] else: [], map(split(trim(first(lines)), "\\s+"), _key)) else: []
        | let body = if (with_header): slice(lines, 1, len(lines)) else: lines
        | map(body, fn(line): _apply_fields(_zip_dict(names, _split_n(trim(line), len(names))), fields, _keep_empty(spec, true));)
      end
end

def _spec_aligned(spec, fields, output):
  let lines = _spec_lines(spec, output)
  | if (is_empty(lines)): []
    else:
      do
        let dashes = has(spec, "offsets") && spec["offsets"] == "dashes"
        | let header = first(lines)
        | let starts = if (dashes): _dash_starts(lines[1]) else: _column_starts(header)
        | let raw = _cut_at(header, starts)
        | let names = if (has(spec, "keys") && spec["keys"] == "raw"): raw else: map(raw, _key)
        | let body = if (dashes): slice(lines, 2, len(lines)) else: slice(lines, 1, len(lines))
        | map(body, fn(line): _apply_fields(_zip_dict(names, _cut_at(line, starts)), fields, _keep_empty(spec, true));)
      end
end

def _spec_delimited(spec, fields, output):
  let lines = _spec_lines(spec, output)
  | if (is_empty(lines)): []
    else:
      do
        let sep = if (has(spec, "separator")): spec["separator"] else: "\\t"
        | let names = map(split(first(lines), sep), fn(name): _key(trim(name));)
        | map(slice(lines, 1, len(lines)), fn(line): _apply_fields(_zip_dict(names, map(split(line, sep), trim)), fields, _keep_empty(spec, true));)
      end
end

def _spec_kv(spec, fields, output):
  let sep = if (has(spec, "separator")): spec["separator"] else: ":"
  | let unquote = has(spec, "unquote") && spec["unquote"]
  | let shape = fn(d): _apply_fields(if (unquote): dict(map(entries(d), fn(kv): [kv[0], _unquote(kv[1])];)) else: d, fields, _keep_empty(spec, true));
  | if (has(spec, "blocks") && spec["blocks"]): map(kv_blocks_parse(join(filter(split(_spec_text(spec, output), "\n"), fn(line): !_skipped(spec, line);), "\n"), sep), shape)
    else: shape(kv_parse(join(_spec_lines(spec, output), "\n"), sep))
end

def _spec_tree(spec, fields, output):
  let rows = filter(map(_spec_lines(spec, output), fn(line): capture(line, spec["pattern"]);), fn(m): !is_empty(keys(m));)
  | let base = if (has(spec, "base")): spec["base"] else: 1
  | let with_depth = map(rows, fn(m): set(m, "depth", base + trunc(len(m["indent"]) / spec["unit"]));)
  | let paths = if (has(spec, "path") && spec["path"]): fold(with_depth, {"stack": [], "out": []}, fn(acc, m):
        let stack = add(slice(acc["stack"], 0, m["depth"] - base), [m["name"]])
        | {"stack": stack, "out": add(acc["out"], [set(m, "path", join(stack, "/"))])};
      )["out"] else: with_depth
  | map(paths, fn(m): _apply_fields(dict(filter(entries(m), fn(kv): kv[0] != "indent";)), fields, _keep_empty(spec, false));)
end

# Reads one line of words as a dict: the first word (after an optional type
# word) is `first`, a word in `keys` takes the next word as its value, and any
# other word is collected in the `flags` array.
def _words_row(tokens, spec):
  let types = if (has(spec, "prefix_types")): spec["prefix_types"] else: []
  | let typed = contains(types, tokens[0]) && len(tokens) > 1
  | let head = if (typed): tokens[1] else: tokens[0]
  | let rest = slice(tokens, if (typed): 2 else: 1, len(tokens))
  | let st = fold(rest, {"d": set({}, spec["first"], head), "key": None, "flags": []}, fn(acc, t):
      if (!is_none(acc["key"])): {"d": set(acc["d"], acc["key"], t), "key": None, "flags": acc["flags"]}
      elif (contains(spec["keys"], t)): {"d": acc["d"], "key": t, "flags": acc["flags"]}
      else: {"d": acc["d"], "key": None, "flags": add(acc["flags"], [t])};
    )
  | let with_type = if (typed): set(st["d"], "type", tokens[0]) else: st["d"]
  | if (is_empty(st["flags"])): with_type else: set(with_type, "flags", st["flags"])
end

def _spec_words(spec, fields, output):
  map(_spec_lines(spec, output), fn(line): _apply_fields(_words_row(split(trim(line), "\\s+"), spec), fields, true);)
end

def _spec_lines_type(spec, output):
  map(_spec_lines(spec, output), trim)
end

# Runs a spec against the output.
def _run_spec(spec, fields, output):
  let kind = spec["type"]
  | if (kind == "regex"): _spec_regex(spec, fields, output)
    elif (kind == "columns"): _spec_columns(spec, fields, output)
    elif (kind == "aligned"): _spec_aligned(spec, fields, output)
    elif (kind == "delimited"): _spec_delimited(spec, fields, output)
    elif (kind == "kv"): _spec_kv(spec, fields, output)
    elif (kind == "tree"): _spec_tree(spec, fields, output)
    elif (kind == "record"): _spec_record(spec, fields, output)
    elif (kind == "blocks"): _spec_blocks(spec, fields, output)
    elif (kind == "words"): _spec_words(spec, fields, output)
    elif (kind == "lines"): _spec_lines_type(spec, output)
    elif (kind == "choice"): _spec_choice(spec, fields, output)
    elif (kind == "indent"): _spec_indent(spec, fields, output)
    else: error("cmd: unknown spec type `" + kind + "`")
end

# Runs a registry entry's parser: its spec, or its function.
def _run_entry(entry, output):
  let parse = entry["parse"]
  | if (is_dict(parse)): _run_spec(parse, if (has(entry, "fields")): entry["fields"] else: {}, output)
    else: parse(output)
end

# Parses the output with the registry entry for `key`, without checking its
# signature. The public `*_parse` functions of migrated parsers call this.
def _by_key(key, output):
  let entry = _find(key)
  | if (is_none(entry)): error("cmd: no parser for `" + key + "`") else: _run_entry(entry, output)
end

# Reads the stable colon format used by GnuPG key listings. Unknown records
# and fields are ignored so newer GnuPG versions can add either one.
def _gpg_colon_row(line):
  let cols = split(line, ":")
  | let record = cols[0]
  | let fields =
      if (contains(["pub", "sec", "sub", "ssb"], record)):
        [["validity", 1], ["bits", 2], ["algorithm", 3], ["key_id", 4], ["created", 5], ["expires", 6], ["ownertrust", 8], ["capabilities", 11], ["curve", 16]]
      elif (record == "uid"): [["validity", 1], ["created", 5], ["expires", 6], ["user_id", 9]]
      elif (record == "uat"): [["validity", 1], ["created", 5], ["expires", 6], ["attribute", 9]]
      elif (record == "fpr" || record == "fp2"): [["fingerprint", 9]]
      elif (record == "grp"): [["keygrip", 9]]
      else: None
  | if (is_none(fields)): None
    else: fold(fields, {"record": record}, fn(acc, field):
      let value = if (field[1] < len(cols)): cols[field[1]] else: ""
      | if (value == ""): acc
        else: set(acc, field[0], if (field[0] == "bits"): _num(value) else: value);
    )
end

def _gpg_colons_parse(output):
  filter(map(_lines(output), _gpg_colon_row), fn(row): !is_none(row);)
end

# Reads the line-oriented porcelain v2 format without the `-z` option.
def _git_status_v2_spec():
  {"type": "regex", "patterns": [
    {"re": "^# (?<name>branch\\.[a-z]+|stash) (?<value>.*)$", "set": {"record": "header"}},
    {"re": "^2 (?<xy>\\S{2}) (?<submodule>\\S+) (?<head_mode>\\S+) (?<index_mode>\\S+) (?<worktree_mode>\\S+) (?<head_oid>\\S+) (?<index_oid>\\S+) (?<score>[RC]\\d+) (?<path>.*)\\t(?<original_path>.*)$", "set": {"record": "rename"}},
    {"re": "^1 (?<xy>\\S{2}) (?<submodule>\\S+) (?<head_mode>\\S+) (?<index_mode>\\S+) (?<worktree_mode>\\S+) (?<head_oid>\\S+) (?<index_oid>\\S+) (?<path>.*)$", "set": {"record": "change"}},
    {"re": "^u (?<xy>\\S{2}) (?<submodule>\\S+) (?<base_mode>\\S+) (?<ours_mode>\\S+) (?<theirs_mode>\\S+) (?<worktree_mode>\\S+) (?<base_oid>\\S+) (?<ours_oid>\\S+) (?<theirs_oid>\\S+) (?<path>.*)$", "set": {"record": "unmerged"}},
    {"re": "^\\? (?<path>.*)$", "set": {"record": "untracked"}},
    {"re": "^! (?<path>.*)$", "set": {"record": "ignored"}}
  ]}
end

# Extracts certificate identity, validity, public key details and extensions
# from `openssl x509 -text -noout` without retaining key or signature dumps.
def _openssl_x509_text_spec():
  {"type": "record", "require": ["subject", "issuer"], "captures": [
    {"re": "(?m)^[ \\t]*Version: (?<version>\\d+)"},
    {"re": "(?m)^[ \\t]*Serial Number:[ \\t]*(?<serial>[^\\n]+)$"},
    {"re": "(?m)^[ \\t]*Serial Number:[ \\t]*\\n[ \\t]+(?<serial>[0-9a-fA-F:]+)$"},
    {"re": "(?m)^[ \\t]*Signature Algorithm: (?<signature_algorithm>[^\\n]+)$"},
    {"re": "(?m)^[ \\t]*Issuer: (?<issuer>[^\\n]+)$"},
    {"re": "(?m)^[ \\t]*Not Before: (?<not_before>[^\\n]+)$"},
    {"re": "(?m)^[ \\t]*Not After[ \\t]*: (?<not_after>[^\\n]+)$"},
    {"re": "(?m)^[ \\t]*Subject: (?<subject>[^\\n]+)$"},
    {"re": "(?m)^[ \\t]*Public Key Algorithm: (?<public_key_algorithm>[^\\n]+)$"},
    {"re": "(?m)^[ \\t]*(?:RSA Public-Key|Public-Key): \\((?<public_key_bits>\\d+) bit\\)"},
    {"re": "(?m)^[ \\t]+X509v3 (?<name>[A-Z][^:\\n]+):[ \\t]*(?<critical>critical)?[ \\t]*\\n(?<value>(?:[ \\t]{16,}[^\\n]*(?:\\n|$))*)", "all": true, "into": "extensions", "fields": {"critical": {"type": "bool", "true_values": ["critical"], "default": false}, "value": {"trim": true, "squeeze": true}}}
  ]}
end

# Parser registry. Entries without a signature are used only when named.
def _registry():
  [
    {"key": "ps", "sig": "\\A\\s*(?:USER\\s+PID|UID\\s+PID|PID\\s+(?:TTY|TT)\\s)", "parse": {"type": "columns"}, "fields": {"pid": {"type": "int"}, "ppid": {"type": "int"}, "cpu_percent": {"type": "int"}, "mem_percent": {"type": "int"}, "vsz": {"type": "int"}, "rss": {"type": "int"}}},
    {"key": "df", "sig": "\\A(?:df: [^\\n]*\\n)*Filesystem\\s+", "parse": {"type": "columns", "replace": [["Mounted on", "Mounted_on"]]}, "fields": {"filesystem": {"type": "string"}, "mounted_on": {"type": "string"}, "*": {"type": "int"}}},
    {"key": "du", "sig": None, "parse": {"type": "regex", "patterns": ["^(?<size>[^\\t]*)\\t(?<path>.*)$"]}, "fields": {"size": {"type": "int"}}},
    {"key": "ls", "sig": "\\A(?:total \\d+\\n)?(?:[-dlbcps][-rwxsStT]{9}[@+.]?\\s+\\d+\\s+\\S+\\s+\\S+\\s+\\d+\\s+\\w{3}\\s+\\d{1,2}\\s+(?:\\d{2}:\\d{2}|\\d{4})\\s+[^\\n]+\\n)*[-dlbcps][-rwxsStT]{9}[@+.]?\\s+\\d+\\s+\\S+\\s+\\S+\\s+\\d+\\s+\\w{3}\\s+\\d{1,2}\\s+(?:\\d{2}:\\d{2}|\\d{4})\\s+[^\\n]+\\n*\\z", "parse": {"type": "regex", "patterns": ["^(?<permissions>[l]\\S{9,10})\\s+(?<links>\\d+)\\s+(?<owner>\\S+)\\s+(?<group>\\S+)\\s+(?<size>\\d+)\\s+(?<modified>\\w{3}\\s+\\d{1,2}\\s+(?:\\d{2}:\\d{2}|\\d{4}))\\s+(?<name>.*?) -> (?<link_target>.*)$", "^(?<permissions>[-dlbcps]\\S{9,10})\\s+(?<links>\\d+)\\s+(?<owner>\\S+)\\s+(?<group>\\S+)\\s+(?<size>\\d+)\\s+(?<modified>\\w{3}\\s+\\d{1,2}\\s+(?:\\d{2}:\\d{2}|\\d{4}))\\s+(?<name>.*)$"]}, "fields": {"links": {"type": "int"}, "size": {"type": "int"}, "modified": {"squeeze": true}, "type": {"derive": {"op": "prefix", "from": "permissions", "map": {"d": "directory", "l": "symlink", "-": "file"}, "default": "other"}}}},
    {"key": "id", "sig": "\\A\\s*uid=\\d+(?:\\([^)\\n]*\\))? gid=\\d+[^\\n]*\\n*\\z", "parse": {"type": "record", "require": ["uid", "gid"], "captures": [{"re": "\\buid=(?<uid>\\d+)(?:\\((?<user>[^)]*)\\))?"}, {"re": "\\bgid=(?<gid>\\d+)(?:\\((?<group>[^)]*)\\))?"}, {"within": "\\bgroups=(?<value>\\S+)", "re": "(?<id>\\d+)(?:\\((?<name>[^)]*)\\))?", "all": true, "into": "groups", "fields": {"id": {"type": "int"}}}]}, "fields": {"uid": {"type": "int"}, "gid": {"type": "int"}}},
    {"key": "wc", "sig": None, "parse": {"type": "regex", "patterns": ["^\\s*(?<lines>\\d+)\\s+(?<words>\\d+)\\s+(?<bytes>\\d+)(?:\\s+(?<file>.*))?$"]}, "fields": {"lines": {"type": "int"}, "words": {"type": "int"}, "bytes": {"type": "int"}}},
    {"key": "ping", "sig": "packets transmitted, \\d+ (?:packets )?received", "parse": {"type": "record", "require": ["transmitted", "loss_percent"], "patterns": ["(?<transmitted>\\d+) packets transmitted, (?<received>\\d+) (?:packets )?received", "(?<loss_percent>[\\d.]+)% packet loss", "= (?<rtt_min>[\\d.]+)/(?<rtt_avg>[\\d.]+)/(?<rtt_max>[\\d.]+)/(?<rtt_stddev>[\\d.]+) ms"]}, "fields": {"*": {"type": "float"}}},
    {"key": "lsof", "sig": "\\A\\s*COMMAND\\s+PID\\s+(?:TID\\s+TASKCMD\\s+)?USER", "parse": {"type": "columns"}, "fields": {"pid": {"type": "int"}}},
    {"key": "free", "sig": "\\A\\s+total\\s+used\\s+free", "parse": {"type": "columns", "prefix_headers": ["type"], "keep_empty": false}, "fields": {"type": {"remove": ":"}, "*": {"type": "int"}}},
    {"key": "top", "sig": "^\\s*PID\\s+(?:COMMAND|USER)\\s+[^\\n]*%CPU", "parse": {"type": "columns", "start_at": "^\\s*PID\\s+"}, "fields": {"pid": {"type": "int"}, "cpu_percent": {"type": "int"}, "mem_percent": {"type": "int"}}},
    {"key": "uptime", "sig": "\\A\\s*\\d{1,2}:\\d{2}(?::\\d{2})?\\s+up\\s+[^\\n]*load averages?:[^\\n]*\\n*\\z", "parse": {"type": "regex", "single": true, "patterns": ["(?<time>\\d{1,2}:\\d{2}(?::\\d{2})?)\\s+up\\s+(?<uptime>.*?),\\s+(?<users>\\d+) users?,\\s+load averages?:\\s+(?<load_1>[\\d.]+),?\\s+(?<load_5>[\\d.]+),?\\s+(?<load_15>[\\d.]+)"]}, "fields": {"users": {"type": "int"}, "load_1": {"type": "float"}, "load_5": {"type": "float"}, "load_15": {"type": "float"}}},
    {"key": "who", "sig": None, "parse": {"type": "regex", "patterns": ["^(?<user>\\S+)\\s+(?<tty>\\S+)\\s+(?<login>.+?)(?:\\s+\\((?<host>[^)]*)\\))?$"], "trim": true}},
    {"key": "w", "sig": "\\A[^\\n]*\\bup\\b[^\\n]*\\nUSER\\s+TTY\\s+(?:FROM\\s+)?LOGIN@", "parse": {"type": "columns", "start_at": "^USER\\s+TTY"}},
    {"key": "mount", "sig": _shape("\\S[^\\n]* on [^\\n]+? (?:type \\S+ )?\\([^\\n]*\\)"), "parse": {"type": "regex", "patterns": ["^(?<device>.+?) on (?<mount_point>.+?) type (?<type>\\S+) \\((?<options>.*)\\)$", "^(?<device>.+?) on (?<mount_point>.+?) \\((?<type>[^,)]+)(?:, (?<options>.*))?\\)$"]}, "fields": {"options": {"type": "array", "default": []}}},
    {"key": "uname", "sig": "\\A(?:Darwin|Linux|FreeBSD|OpenBSD|NetBSD|SunOS|CYGWIN\\S*|MINGW\\S*) \\S+ \\S+ [^\\n]+\\n*\\z", "parse": {"type": "regex", "single": true, "trim": true, "patterns": ["^(?<kernel_name>\\S+) (?<node_name>\\S+) (?<kernel_release>\\S+) (?<kernel_version>.+) (?<machine>\\S+) \\S+ \\S+ GNU/Linux$", "^(?<kernel_name>\\S+) (?<node_name>\\S+) (?<kernel_release>\\S+) (?<kernel_version>.+) (?<machine>\\S+)$"]}},
    {"key": "sysctl", "sig": None, "parse": {"type": "regex", "as": "map", "patterns": ["^(?<key>[^:=\\s]+)\\s*[:=]\\s*(?<value>.*)$"]}},
    {"key": "vm_stat", "sig": "\\AMach Virtual Memory Statistics", "parse": {"type": "regex", "as": "map", "normalize_keys": true, "patterns": [{"re": "page size of (?<value>\\d+) bytes", "set": {"key": "page_size"}}, "^\"?(?<key>[^\":]+)\"?:\\s+(?<value>\\d+)\\.?$"]}, "fields": {"*": {"type": "int"}}},
    {"key": "vmstat", "sig": "^\\s*r\\s+b\\s+(?:swpd|avm)", "parse": {"type": "columns", "start_at": "^\\s*r\\s+b\\s"}, "fields": {"*": {"type": "int"}}},
    {"key": "launchctl", "sig": "\\APID\\tStatus\\tLabel", "parse": {"type": "columns"}, "fields": {"pid": {"type": "int", "null_if": ["-"]}, "status": {"type": "int"}}},
    {"key": "ifconfig", "sig": "\\A\\S+: flags=\\d+<", "parse": {"type": "blocks", "start": "^\\S", "require": ["name"], "captures": [{"re": "^(?<name>[^:\\s]+):?\\s+flags=\\d+<(?<flags>[^>]*)>\\s+mtu\\s+(?<mtu>\\d+)"}, {"re": "ether (?<ether>\\S+)"}, {"re": "status: (?<status>\\w+)"}, {"re": "inet (?<address>\\S+) netmask (?<netmask>\\S+)", "all": true, "into": "ipv4"}, {"re": "inet6 (?<address>\\S+) prefixlen (?<prefixlen>\\d+)", "all": true, "into": "ipv6", "fields": {"prefixlen": {"type": "int"}}}]}, "fields": {"flags": {"type": "array", "split": ","}, "mtu": {"type": "int"}}},
    {"key": "netstat", "sig": "^(?:tcp|udp)[46]?\\S*\\s+\\d+\\s+\\d+\\s+\\S+\\s+\\S+", "parse": {"type": "regex", "patterns": ["^(?<proto>(?:tcp|udp|raw|icmp)\\S*)\\s+(?<recv_q>\\d+)\\s+(?<send_q>\\d+)\\s+(?<local_address>\\S+)\\s+(?<foreign_address>\\S+)(?:\\s+(?<state>[A-Z][A-Z_0-9]+)(?:\\s+(?<program>.*))?|\\s+.*)?$"], "trim": true}, "fields": {"recv_q": {"type": "int"}, "send_q": {"type": "int"}}},
    {"key": "ss", "sig": "\\A(?:Netid\\s+State|State\\s+Recv-Q\\s+Send-Q)", "parse": {"type": "regex", "patterns": ["^(?<netid>tcp|udp|raw|icmp\\S*|u_\\S+|p_\\S+|nl)\\s+(?<state>[A-Z][A-Z0-9-]+)\\s+(?<recv_q>\\d+)\\s+(?<send_q>\\d+)\\s+(?<local_address>\\S+)\\s+(?<peer_address>\\S+)(?:\\s+(?<process>.*))?$", "^(?<state>[A-Z][A-Z0-9-]+)\\s+(?<recv_q>\\d+)\\s+(?<send_q>\\d+)\\s+(?<local_address>\\S+)\\s+(?<peer_address>\\S+)(?:\\s+(?<process>.*))?$"], "trim": true}, "fields": {"recv_q": {"type": "int"}, "send_q": {"type": "int"}}},
    {"key": "arp", "sig": _shape("\\S+ \\(\\d+\\.\\d+\\.\\d+\\.\\d+\\) at [^\\n]+"), "parse": {"type": "regex", "patterns": ["^(?<host>\\S+) \\((?<ip>[^)]+)\\) at (?<mac>\\S+)(?: on (?<interface>\\S+))?"]}},
    {"key": "ip addr", "sig": "\\A\\d+: \\S+: <[^>]*> mtu \\d+|" + _shape("\\S+\\s+(?:UP|DOWN|UNKNOWN|LOWERLAYERDOWN|DORMANT|NOTPRESENT|TESTING)(?:\\s[^\\n]*)?"), "parse": {"type": "choice", "options": [{"when": "\\A\\d+: ", "parse": {"type": "blocks", "start": "^\\d+: ", "require": ["name"], "captures": [{"re": "^(?<index>\\d+): (?<name>[^:@\\s]+)(?:@\\S+)?: <(?<flags>[^>]*)> mtu (?<mtu>\\d+).*? state (?<state>\\S+)"}, {"re": "link/\\S+ (?<mac>[0-9a-f:]{17})"}, {"re": "inet (?<value>\\S+)", "all": true, "values": true, "into": "ipv4"}, {"re": "inet6 (?<value>\\S+)", "all": true, "values": true, "into": "ipv6"}]}, "fields": {"index": {"type": "int"}, "flags": {"type": "array", "split": ","}, "mtu": {"type": "int"}}}, {"parse": {"type": "regex", "trim": true, "patterns": ["^(?<name>\\S+)\\s+(?<state>\\S+)(?:\\s+(?<addresses>.*))?$"]}, "fields": {"addresses": {"type": "array", "split": "\\s+", "default": []}}}]}},
    {"key": "ip link", "sig": None, "parse": {"type": "blocks", "start": "^\\d+: ", "require": ["name"], "captures": [{"re": "^(?<index>\\d+): (?<name>[^:@\\s]+)(?:@\\S+)?: <(?<flags>[^>]*)> mtu (?<mtu>\\d+).*? state (?<state>\\S+)"}, {"re": "link/\\S+ (?<mac>[0-9a-f:]{17})"}]}, "fields": {"index": {"type": "int"}, "flags": {"type": "array", "split": ","}, "mtu": {"type": "int"}}},
    {"key": "ip route", "sig": None, "parse": {"type": "words", "first": "destination", "prefix_types": ["unicast", "local", "broadcast", "multicast", "blackhole", "unreachable", "prohibit", "throw", "nat"], "keys": ["via", "dev", "proto", "scope", "src", "metric", "table", "mtu", "weight", "expires", "pref", "initcwnd", "advmss", "hoplimit", "rtt"]}, "fields": {"*": {"type": "int"}}},
    {"key": "ip rule", "sig": None, "parse": {"type": "regex", "patterns": ["^(?<priority>\\d+): (?<selector>.*?) lookup (?<table>\\S+)(?: (?<options>.*))?$"]}, "fields": {"priority": {"type": "int"}}},
    {"key": "bridge link", "sig": None, "parse": {"type": "blocks", "start": "^\\d+: ", "require": ["name"], "captures": [{"re": "^(?<index>\\d+): (?<name>[^:@\\s]+)(?:@\\S+)?: <(?<flags>[^>]*)> mtu (?<mtu>\\d+).*? state (?<state>\\S+)"}, {"re": "master (?<master>\\S+)"}]}, "fields": {"index": {"type": "int"}, "flags": {"type": "array", "split": ","}, "mtu": {"type": "int"}}},
    {"key": "bridge fdb", "sig": None, "parse": {"type": "words", "first": "mac", "keys": ["dev", "master", "vlan", "dst", "via"]}, "fields": {"vlan": {"type": "int"}}},
