    {"key": "timedatectl", "sig": "^\\s+Local time:", "parse": {"type": "kv", "separator": ":"}},
    {"key": "timedatectl show", "sig": None, "parse": {"type": "kv", "separator": "="}},
    {"key": "git log", "sig": "\\Acommit [0-9a-f]{7,64}", "parse": {"type": "blocks", "start": "^commit ", "require": ["commit"], "captures": [{"re": "^commit (?<commit>[0-9a-f]+)(?: \\((?<refs>[^)]*)\\))?"}, {"re": "(?m)^Author: (?<author>.*)$"}, {"re": "(?m)^Date:\\s+(?<date>.*)$"}, {"re": "(?m)^Merge: (?<merge>.*)$"}, {"re": "(?m)^ {4}(?<value>.*)$", "all": true, "values": true, "into": "message", "join": "\n", "trim": true}]}},
    {"key": "git log --oneline", "sig": None, "parse": {"type": "regex", "patterns": ["^(?<commit>[0-9a-f]{7,40})(?: \\((?<refs>[^)]*)\\))? (?<message>.*)$"]}},
    {"key": "git status", "sig": None, "parse": {"type": "regex", "patterns": ["^(?<index>.)(?<worktree>.) (?<orig_path>.+?) -> (?<path>.+)$", "^(?<index>.)(?<worktree>.) (?<path>.+)$"], "skip": ["^## "], "keep_empty": true}},
