    {"key": "resolvectl status", "sig": "\\A(?:Global|Link \\d+ \\([^)\\n]+\\))\\n", "parse": {"type": "blocks", "start": "^(?:Global|Link \\d+)", "require": ["name"], "captures": [{"re": "^(?<name>Global|Link \\d+(?: \\([^)]*\\))?)"}, {"re": "(?m)^[ \\t]*(?<key>[A-Za-z][^:\\n]*?):[ \\t]*(?<value>\\S.*)$", "all": true, "merge": true}]}},
    {"key": "systemd-analyze blame", "sig": _shape("\\s*(?:[\\d.]+(?:h|min|s|ms|us|d) ?)+\\s+\\S+\\.(?:service|mount|target|socket|timer|device|path|slice|scope|swap|automount)"), "parse": {"type": "regex", "trim": true, "patterns": ["^(?<time>(?:[\\d.]+(?:h|min|s|ms|us|d) ?)+?)\\s+(?<unit>\\S+)$"]}},
    {"key": "fdisk", "sig": "\\ADisk /dev/\\S+: [^\\n]*, \\d+ bytes, \\d+ sectors", "parse": {"type": "blocks", "start": "^Disk /dev/", "require": ["device"], "captures": [{"re": "^Disk (?<device>/dev/\\S+): (?<size>[^,]+), (?<bytes>\\d+) bytes, (?<sectors>\\d+) sectors"}, {"re": "(?m)^Disk model: (?<model>.*?)[ \\t]*$"}, {"re": "(?m)^Disklabel type: (?<label_type>\\S+)"}, {"re": "(?m)^Disk identifier: (?<identifier>\\S+)"}, {"re": "(?m)^(?<device>/dev/\\S+)[ \\t]+(?:(?<boot>\\*)[ \\t]+)?(?<start>\\d+)[ \\t]+(?<end>\\d+)[ \\t]+(?<sectors>\\d+)[ \\t]+(?<size>\\S+)[ \\t]+(?<type>\\S.*?)[ \\t]*$", "all": true, "into": "partitions", "fields": {"start": {"type": "int"}, "end": {"type": "int"}, "sectors": {"type": "int"}}}]}, "fields": {"bytes": {"type": "int"}, "sectors": {"type": "int"}}}
  ]
end

# Command names that share a parser with another command.
def _name_aliases():
  {
    "pip3": "pip", "yum": "dnf", "podman": "docker", "ping6": "ping", "printenv": "env", "journalctl": "syslog", "tracepath": "traceroute",
    "md5": "checksum", "md5sum": "checksum", "shasum": "checksum", "sha1sum": "checksum", "sha224sum": "checksum", "sha256sum": "checksum", "sha384sum": "checksum", "sha512sum": "checksum", "b2sum": "checksum",
    "sum": "cksum", "dpkg-query": "dpkg", "networkctl": "networkctl list", "busctl": "busctl list", "resolvectl": "resolvectl status", "systemd-resolve": "resolvectl status",
    "rg": "grep", "egrep": "grep", "fgrep": "grep", "ag": "grep", "find": "lines", "pkgconf": "pkg-config"
  }
end

# Subcommands that share a parser with another `command subcommand` key.
def _key_aliases():
  {
    "docker container": "docker ps", "docker image": "docker images", "docker compose": "docker ps",
    "npm list": "npm ls", "npm ll": "npm ls", "ip a": "ip addr", "ip address": "ip addr", "ip r": "ip route",
    "getent passwd": "passwd", "getent group": "group", "apt-get list": "apt list",
    "nmcli con": "nmcli connection", "nmcli c": "nmcli connection", "nmcli dev": "nmcli device", "nmcli d": "nmcli device",
    "localectl status": "localectl", "lsb_release a": "lsb_release",
    "ip neigh": "ip neighbour", "ip neighbor": "ip neighbour", "ip n": "ip neighbour",
    "pkgconf list": "pkg-config list", "pkgconf version": "pkg-config version", "ssh-add -l": "ssh-keygen",
    "gpg --list-keys --with-colons": "gpg keys", "gpg --list-secret-keys --with-colons": "gpg keys"
  }
end

# Returns the registry entry for a key or an alias, or None.
def _find(key):
  let names = _name_aliases()
  | let subs = _key_aliases()
  | let resolved = if (has(subs, key)): subs[key] elif (has(names, key)): names[key] else: key
  | let hits = filter(_registry(), fn(entry): entry["key"] == resolved;)
  | if (is_empty(hits)): None else: hits[0]
end

# Returns the first non-flag argument, skipping the value of the flags in
# `value_flags` (for example `git -C path` or `kubectl -n namespace`).
def _subcommand(args, value_flags):
  let st = fold(args, {"skip": false, "sub": None}, fn(acc, a):
    if (!is_none(acc["sub"])): acc
    elif (acc["skip"]): {"skip": false, "sub": None}
    elif (contains(value_flags, a)): {"skip": true, "sub": None}
    elif (starts_with(a, "-")): acc
    else: {"skip": false, "sub": a};
  )
  | if (is_none(st["sub"])): "" else: st["sub"]
end

# Picks output formats selected by command flags, in precedence order.
def _flag_variant(with_sub, args):
  let variants = [
    {"base": "git log", "flag": "--oneline", "key": "git log --oneline"},
    {"base": "git diff", "flag": "--numstat", "key": "git diff --numstat"},
    {"base": "git diff", "flag": "--name-status", "key": "git diff --name-status"},
    {"base": "git diff", "flag": "--name-only", "key": "git diff --name-only"},
    {"base": "git diff", "flag": "--shortstat", "key": "git diff --shortstat"},
    {"base": "git diff", "flag": "--stat", "key": "git diff --stat"},
    {"base": "git check-ignore", "flag": "-v", "key": "git check-ignore -v"},
    {"base": "git check-ignore", "flag": "--verbose", "key": "git check-ignore -v"},
    {"base": "git blame", "flag": "--line-porcelain", "key": "git blame --line-porcelain"},
    {"base": "rustup toolchain", "flag": "list", "key": "rustup toolchain list"},
    {"base": "rustup target", "flag": "list", "key": "rustup target list"},
    {"base": "rustup component", "flag": "list", "key": "rustup component list"},
    {"base": "uv pip", "flag": "show", "key": "uv pip show"}
  ]
  | let matches = filter(variants, fn(v): v["base"] == with_sub && contains(args, v["flag"]);)
  | if (is_empty(matches)): with_sub else: matches[0]["key"]
end

# Recognizes a short option alone or inside a bundle such as `-avi`.
def _has_short_flag(args, flag):
  contains(map(args, fn(arg): is_regex_match(arg, "^-[A-Za-z]*" + flag + "[A-Za-z]*$");), true)
end

# Handles formats selected by options that are not part of a subcommand.
def _option_variant(name, args, with_sub):
  if (with_sub == "git status" && (contains(args, "--porcelain=v2") || contains(args, "--porcelain=2"))):
    if (contains(args, "-z") || contains(args, "--null")): "git status --porcelain=v2 -z" else: "git status --porcelain=v2"
  elif (name == "dpkg" && (contains(args, "-s") || contains(args, "--status"))): "dpkg status"
  elif (name == "netstat" && (contains(args, "-r") || contains(args, "-rn") || contains(args, "-nr") || contains(args, "--route"))): "netstat routes"
  elif (name == "lscpu" && (contains(args, "-e") || contains(args, "--extended"))): "lscpu extended"
  elif (name == "pkg-config" && contains(args, "--list-all")): "pkg-config list"
  elif (name == "pkg-config" && contains(args, "--modversion")): "pkg-config version"
  elif (name == "just" && (contains(args, "--list") || contains(args, "-l"))): "just list"
  elif (name == "shellcheck" && (contains(args, "--format=gcc") || contains(args, "-f=gcc"))): "shellcheck gcc"
  elif (name == "actionlint" && contains(args, "-oneline")): "actionlint oneline"
  elif (name == "ssh" && contains(args, "-G")): "ssh config"
  elif (name == "ssh-add" && contains(args, "-L")): "ssh-add -L"
  elif (name == "ssh-add" && contains(args, "-l")): "ssh-add -l"
  elif (name == "gpg" && contains(args, "--with-colons") && (contains(args, "--list-keys") || contains(args, "-k") || contains(args, "--list-public-keys") || contains(args, "--list-secret-keys") || contains(args, "-K"))): "gpg keys"
  elif (with_sub == "openssl x509" && contains(args, "-text")): "openssl x509 text"
  elif (with_sub == "openssl x509" && contains(args, "-noout") && (contains(args, "-subject") || contains(args, "-issuer") || contains(args, "-serial") || contains(args, "-dates") || contains(args, "-startdate") || contains(args, "-enddate") || contains(args, "-fingerprint"))): "openssl x509 summary"
  elif (name == "rsync" && contains(args, "--stats")): "rsync stats"
  elif (name == "rsync" && (_has_short_flag(args, "i") || contains(args, "--itemize-changes"))): "rsync itemize"
  elif (name == "service" && contains(args, "--status-all")): "service status-all"
  elif (name == "ldconfig" && (contains(args, "-p") || contains(args, "--print-cache"))): "ldconfig cache"
  elif (name == "readelf" && (contains(args, "-h") || contains(args, "--file-header"))): "readelf header"
  elif (name == "readelf" && (contains(args, "-d") || contains(args, "--dynamic"))): "readelf dynamic"
  elif (name == "ar" && (contains(args, "t") || contains(args, "-t"))): "ar t"
  elif (name == "networksetup" && !is_empty(args)): "networksetup " + args[0]
  else: with_sub
end

# Returns the parser key for a command, e.g. "git log" or "ps". Tries
# `name subcommand` (with the git `--oneline`, `--numstat` and `--stat`
# variants), then `name`, and falls back to the subcommand key so the error
# names what was asked for.
def _parser_key(cmd, args):
  let base = basename(cmd)
  | let aliases = _name_aliases()
  | let alias = if (has(aliases, base)): aliases[base] else: base
  | let name = if (contains(alias, " ")): base else: alias
  | let value_flags = if (name == "git"): ["-C", "-c"] elif (name == "kubectl"): ["-n", "--namespace", "--context"] else: []
  | let sub = _subcommand(args, value_flags)
  | let with_sub = name + " " + sub
  | let flagged = _flag_variant(with_sub, args)
  | let variant = if (flagged != with_sub): flagged else: _option_variant(name, args, with_sub)
  | if ((sub != "" || variant != with_sub) && !is_none(_find(variant))): variant
    elif (!is_none(_find(name))): name
    elif (sub != ""): variant
    else: name
end

# Bounds the text inspected by signatures.
def _window(output):
  join(slice(split(output, "\n"), 0, 20), "\n")
end

# Returns whether a signature matches the text.
def _fits(output, sig):
  is_regex_match(_window(output), "(?m)" + sig)
end

# Parses the output of a command with the parser registered for `key`, such
# as "ps", "df", "id", "ping", "git log", "git diff --stat", "pip list",
# "docker ps", "kubectl get", "ip addr" or "ss". Raises an error for an
# unknown key.
#
# Naming a parser is a claim about the text, not a way past the checks: when
# the parser has a signature the text must fit it, otherwise an error lists
# what `detect` finds. Blank output parses to an empty result. Call the
# parser function itself (for example `ps_parse`) to skip the check.
#
# Example:
# ```
# import "cmd" | cmd::parse_output("du", "8\t./src")
# #=> [{"size": 8, "path": "./src"}]
# ```
#
# Returns: array or dict
def parse_output(key, output):
  let entry = _find(key)
  | if (is_none(entry)): error("cmd: no parser for `" + key + "`, use columns_parse, table_parse or kv_parse")
    elif (!is_none(entry["sig"]) && trim(output) != "" && !_fits(output, entry["sig"])): error("cmd: the text does not look like `" + entry["key"] + "` output (" + (if (is_empty(detect(output))): "detect finds no match" else: "detect finds: " + join(detect(output), ", ")) + "). Call the parser function directly to skip this check")
    else:
      _run_entry(entry, output)
end

# Returns the matching parser keys. Generic formats are never returned.
#
# Example:
# ```
# import "cmd" | cmd::detect("uid=501(alice) gid=20(staff)")
# #=> ["id"]
# ```
#
# Returns: array
def detect(output):
  filter(_registry(), fn(entry): !is_none(entry["sig"]) && _fits(output, entry["sig"]);)
  | map(fn(entry): entry["key"];)
end

# Detects the command from the output text and parses it.
# Raises an error when no signature fits or when several do, listing the
# candidates. Use `parse_output` with a key to name the parser explicitly.
#
# Example:
# ```
# import "cmd" | cmd::parse_auto("uid=501(alice) gid=20(staff)")
# #=> {"uid": 501, "user": "alice", "gid": 20, "group": "staff"}
# ```
#
# Returns: array or dict
def parse_auto(output):
  let candidates = detect(output)
  | if (len(candidates) == 1): parse_output(candidates[0], output)
    elif (is_empty(candidates)): error("cmd: could not detect the command, name a parser with parse_output(key, output)")
    else: error("cmd: ambiguous output, candidates: " + join(candidates, ", ") + ". Name a parser with parse_output(key, output)")
end

# Runs a command and parses its output with the parser for the command name
# and subcommand (`git log`, `docker ps`, `ip addr`, ...). Requires the
# --allow-run flag. The command is not run through a shell.
#
# Example:
# ```
# import "cmd" | cmd::run("df", ["-k"])
# ```
#
# Returns: array or dict
def run(cmd, args = []):
  parse_output(_parser_key(cmd, args), system(cmd, args))
end
