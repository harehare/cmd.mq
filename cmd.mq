    {"key": "netstat routes", "sig": "\\A(?:Routing tables|Kernel IP routing table\\nDestination\\s+Gateway\\s+Genmask\\s+Flags\\s+MSS)", "parse": {"type": "choice", "options": [{"when": "\\ARouting tables", "parse": {"type": "blocks", "start": "^Internet6?:", "skip": ["^Destination[ \\t]+Gateway"], "require": ["family"], "captures": [{"re": "^(?<family>Internet6?):"}, {"re": "(?m)^(?<destination>\\S+)[ \\t]+(?<gateway>\\S+)[ \\t]+(?<flags>\\S+)[ \\t]+(?<netif>\\S+)(?:[ \\t]+(?<expire>\\S+))?[ \\t]*$", "all": true, "into": "routes"}]}}, {"parse": {"type": "columns", "start_at": "^Destination\\s+Gateway"}, "fields": {"mss": {"type": "int"}, "window": {"type": "int"}, "irtt": {"type": "int"}}}]}},
    {"key": "networksetup -listnetworkserviceorder", "sig": "\\A(?:An asterisk[^\\n]*\\n)?\\((?:\\d+|\\*)\\) ", "parse": {"type": "blocks", "start": "^\\((?:\\d+|\\*)\\) ", "require": ["service"], "captures": [{"re": "(?m)^\\((?<order>\\d+|\\*)\\) (?<service>.*)$"}, {"re": "Hardware Port: (?<hardware_port>[^,]+), Device: (?<device>[^)]*)"}]}, "fields": {"order": {"type": "int"}}},
