    {"key": "git diff --numstat", "sig": None, "parse": {"type": "regex", "patterns": ["^(?<added>\\d+|-)\\t(?<deleted>\\d+|-)\\t(?<path>.*)$"]}, "fields": {"added": {"type": "int", "null_if": ["-"]}, "deleted": {"type": "int", "null_if": ["-"]}}},
