    {"key": "lipo", "sig": "\\A(?:Architectures in the fat file: [^\\n]* are: [^\\n]*|Non-fat file: [^\\n]* is architecture: [^\\n]*)\\n*\\z", "parse": {"type": "regex", "single": true, "trim": true, "patterns": ["^Architectures in the fat file: (?<file>.*) are: (?<architectures>.*)$", "^Non-fat file: (?<file>.*) is architecture: (?<architectures>.*)$"]}, "fields": {"architectures": {"type": "array", "split": "\\s+"}}},
